@inject EstadoApp Estado

@* Ajustes → Conexión a la base de datos: R.U.T.A. habla directo con MySQL (sin API). Aquí se configura y se prueba. *@
@switch (Clave)
{
    case "conexion":
        <MarcoDetalle Categoria="Base de datos" Titulo="Conexión a la base de datos" Subtitulo="R.U.T.A. se conecta directo a tu MySQL, sin API. Aquí lo configuras y compruebas que funcione.">
            <ChildContent>
                <DosColumnas Lateral="356">
                    <Principal>
                        <Tarjeta Titulo="Datos de MySQL" Subtitulo="Por defecto, el MySQL de este mismo equipo.">
                            @if (Connection.UsaVariableDeEntorno)
                            {
                                <Aviso Icono="IcoAlert" Titulo="Se está usando una variable de entorno" Tipo="alerta">La variable RUTA_DB_CONNECTION tiene prioridad: estos datos no se aplicarán hasta que la quites.</Aviso>
                            }
                            <div class="dos-campos arriba">
                                <div class="etiquetado"><label>Servidor</label><CampoTexto @bind-Text="_c.Servidor" Hint="localhost" Alto="42" /></div>
                                <div class="etiquetado"><label>Puerto</label><CampoTexto @bind-Text="_puerto" Hint="3306" Alto="42" /></div>
                            </div>
                            <div class="etiquetado arriba"><label>Base de datos</label><CampoTexto @bind-Text="_c.BaseDeDatos" Hint="rutadb" Alto="42" /></div>
                            <div class="dos-campos arriba">
                                <div class="etiquetado"><label>Usuario</label><CampoTexto @bind-Text="_c.Usuario" Hint="root" Alto="42" /></div>
                                <div class="etiquetado"><label>Contraseña</label><CampoPassword @bind-Text="_c.Contrasena" /></div>
                            </div>

                            @if (_resultado != null)
                            {
                                <div class="aviso @(_ok ? "aviso-ok" : "aviso-alerta") arriba anima-entra">
                                    <Icon Nombre="@(_ok ? "IcoCheckCircle" : "IcoAlert")" Tam="20" />
                                    <div><p>@_resultado</p></div>
                                </div>
                            }

                            <div class="botones-fila">
                                <Boton Texto="@(_probando ? "Probando…" : "Probar conexión")" Icono="IcoRefresh" Relleno="false" OnClick="Probar" />
                                <Boton Texto="Guardar y usar" Icono="IcoCheck" OnClick="Guardar" />
                            </div>
                        </Tarjeta>
                    </Principal>
                    <Secundario>
                        <Tarjeta Titulo="Cómo funciona" Subtitulo="Todo se guarda en tu MySQL local.">
                            <div class="paso-lista"><span>1</span><div class="fila-ajuste-texto"><b>Enciende MySQL</b><small>El servicio de Windows se llama MySQL80.</small></div></div>
                            <div class="paso-lista"><span>2</span><div class="fila-ajuste-texto"><b>Crea la base de datos</b><small>Con Database/esquema.sql (ver Database/LEEME.md).</small></div></div>
                            <div class="paso-lista"><span>3</span><div class="fila-ajuste-texto"><b>Prueba y guarda</b><small>Si dice «Conexión correcta», ya está.</small></div></div>
                            <Aviso Icono="IcoLock" Titulo="Tu contraseña" Tipo="info">Se guarda solo en este equipo, en un archivo fuera del proyecto: <b>@Connection.Archivo</b></Aviso>
                        </Tarjeta>
                    </Secundario>
                </DosColumnas>
            </ChildContent>
        </MarcoDetalle>
        break;
}

@code {
    [Parameter] public string Clave { get; set; }

    private ConfigConexion _c = new();
    private string _puerto = "3306";
    private string _resultado;
    private bool _ok, _probando;

    protected override void OnInitialized()
    {
        _c = Connection.Actual.Copiar();
        _puerto = _c.Puerto.ToString();
    }

    private ConfigConexion Leer()
    {
        _c.Puerto = int.TryParse(_puerto.Trim(), out int p) && p > 0 ? p : 3306;
        return _c;
    }

    private async Task Probar()
    {
        if (_probando) return;
        _probando = true;
        _resultado = null;
        try
        {
            (_ok, _resultado) = await Connection.ProbarAsync(Leer());
        }
        finally
        {
            _probando = false;
        }
    }

    // Guarda en conexion.json, usa los datos nuevos y vuelve a leer las rutas
    private async Task Guardar()
    {
        try
        {
            Connection.Guardar(Leer());
        }
        catch (Exception ex)
        {
            _ok = false;
            _resultado = "No se pudo guardar la configuración: " + ex.Message;
            return;
        }
        await Estado.RecargarDatosAsync();
        (_ok, _resultado) = await Connection.ProbarAsync();
        _resultado = (_ok ? "Guardado y en uso. " : "Se guardó, pero no conecta: ") + _resultado;
        if (_ok) Estado.MostrarAviso("Conexión guardada");
    }
}
