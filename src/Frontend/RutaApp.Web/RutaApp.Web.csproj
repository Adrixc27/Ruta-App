<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!-- Muestra web de R.U.T.A. (GitHub Pages): la misma interfaz de RutaApp.Interfaz, corriendo en el navegador con WebAssembly.
       Las rutas salen de wwwroot/datos/rutas.json (se genera con tools/ExportarRutas) y lo que la persona guarda queda en su navegador. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>RutaApp.Web</RootNamespace>
    <AssemblyName>RutaApp.Web</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.13" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RutaApp.Interfaz\RutaApp.Interfaz.csproj" />
  </ItemGroup>

</Project>
