@page "/configuracion"
@layout ShellLayout
@inject EstadoApp Estado

<PageTitle>@T["Configuración · R.U.T.A."]</PageTitle>

<div class="pagina">
    <div class="pagina-cabecera">
        <div>
            <h1>@T["Configuración"]<Ayuda Titulo="@(T["Configuración"])" Texto="@(T["Cambia las unidades, activa el modo daltonismo o la guía visual, reporta un problema, consulta la ayuda o administra tu cuenta."])" /></h1>
            <p>@T["Personaliza tu experiencia de navegación y preferencias en RUTA"]</p>
        </div>
        <div class="busqueda-ancha">
            <CampoTexto @bind-Text="_busqueda" Icono="IcoSearch" Hint="@(T["Buscar ajuste..."])" Fondo="var(--bg-card)" Redondeo="999" Alto="38" />
        </div>
    </div>

    <div class="categorias">
        @foreach (var categoria in Visibles)
        {
            <div class="card categoria">
                <h3>@T[categoria.Titulo]</h3>
                @foreach (var ajuste in categoria.Ajustes)
                {
                    var a = ajuste;
                    <button type="button" class="ajuste-item" @onclick='() => Estado.Navegar("ajuste", a)'>
                        <span>@T[a]</span>
                        <Icon Nombre="IcoChevronRight" Tam="16" Color="var(--text-secondary)" />
                    </button>
                }
            </div>
        }
    </div>

    @if (!Visibles.Any())
    {
        <p class="vacio">@T["No se encontró ningún ajuste con ese texto."]</p>
    }

    <div class="card pie-config">
        <span>@T["RUTA - Versión de escritorio"]</span>
        <button type="button" class="btn-ghost subrayado" @onclick='() => Estado.Navegar("ajuste", "Términos de servicio")'>@T["Términos legales y licencias"]</button>
    </div>
</div>

@code {
    private string _busqueda = "";

    private readonly List<CategoriaAjustes> _categorias = new()
    {
        new CategoriaAjustes { Titulo = "GENERAL", Ajustes = { "Unidades de distancia (km / mi)", "Idioma (Español / English)" } },
        new CategoriaAjustes { Titulo = "ACCESIBILIDAD", Ajustes = { "Accesibilidad (daltonismo y guía visual)" } },
        new CategoriaAjustes { Titulo = "CUENTA", Ajustes = { "Mi cuenta (cerrar sesión o borrar cuenta)" } },
        new CategoriaAjustes { Titulo = "SOPORTE", Ajustes = { "Reportar un problema en la ruta", "Comentarios para mejorar la app", "Centro de ayuda" } },
        new CategoriaAjustes { Titulo = "LEGAL", Ajustes = { "Términos de servicio", "Política de privacidad", "Sobre Nosotros" } }
    };

    /// <summary>Solo los ajustes que contienen el texto buscado (y sin categorías vacías).</summary>
    private IEnumerable<CategoriaAjustes> Visibles
    {
        get
        {
            string q = _busqueda.Trim();
            return _categorias
                .Select(c => new CategoriaAjustes
                {
                    Titulo = c.Titulo,
                    Ajustes = c.Ajustes
                        .Where(a => q.Length == 0 ||
                                    a.Contains(q, StringComparison.CurrentCultureIgnoreCase) ||
                                    T[a].Contains(q, StringComparison.CurrentCultureIgnoreCase) ||
                                    T[c.Titulo].Contains(q, StringComparison.CurrentCultureIgnoreCase))
                        .ToList()
                })
                .Where(c => c.Ajustes.Count > 0);
        }
    }
}
