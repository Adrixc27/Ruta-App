@inject EstadoApp Estado
@inject OpinionService Opiniones

@* Ajustes → Soporte: reportar un problema (se publica como aviso en la comunidad) y centro de ayuda con respuestas. *@
@switch (Clave)
{
    case "reportar":
        <MarcoDetalle Categoria="@(T["Soporte"])" Titulo="@(T["Reportar un problema en la ruta"])" Subtitulo="@(T["Avisa a los demás: tu reporte aparece como aviso en la comunidad y se quita solo cuando caduca."])">
            <ChildContent>
                <DosColumnas Lateral="316">
                    <Principal>
                        <Tarjeta Titulo="@(T["¿Qué pasó?"])" Subtitulo="@(T["Elige el problema y, si quieres, cuéntanos más."])">
                            <div class="reporte-tipos">
                                @foreach (var t in EstadoApp.ProblemasComunes)
                                {
                                    var tipo = t;
                                    <button type="button" class="reporte-tipo @(_tipo == tipo.Clave ? "sel" : "")" @onclick="() => ElegirTipo(tipo)">
                                        <Icon Nombre="@tipo.Icono" Tam="20" /><span>@T[tipo.Texto]</span>
                                    </button>
                                }
                            </div>

                            <div class="etiquetado arriba-grande">
                                <label>@T["Ruta afectada"] <small>@T["(opcional)"]</small></label>
                                <div class="select-ruta">
                                    <Icon Nombre="IcoBus" Tam="18" Color="var(--brand-primary)" />
                                    <select @bind="_ruta">
                                        <option value="0">@T["Sin ruta específica"]</option>
                                        @foreach (var r in Estado.Rutas)
                                        {
                                            <option value="@r.Numero">@r.Nombre</option>
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="etiquetado arriba">
                                <label>@T["Detalles"] <small>@T["(opcional)"]</small></label>
                                <textarea class="textarea" rows="3" maxlength="400" placeholder="@(T["Por ejemplo: en Av. Universidad, el camión tiene una llanta ponchada."])" @bind="_detalle" @bind:event="oninput"></textarea>
                            </div>

                            @if (Seleccionado?.Movilidad == true)
                            {
                                <p class="nota nota-ubicacion arriba"><Icon Nombre="IcoLocate" Tam="14" /> @T["Este reporte incluye tu ubicación actual y se marcará en el mapa para que otras personas lo vean."]</p>
                            }
                        </Tarjeta>
                    </Principal>
                    <Secundario>
                        <Tarjeta Titulo="@(T["Antes de enviar"])" Subtitulo="@(T["Revisa tu reporte."])">
                            <div class="chequeo"><Icon Nombre="@(_tipo != null ? "IcoCheckCircle" : "IcoInfo")" Tam="18" Color="@(_tipo != null ? "var(--success)" : "var(--text-secondary)")" /> @T["Problema elegido"]</div>
                            <div class="chequeo"><Icon Nombre="IcoCheckCircle" Tam="18" Color="var(--success)" /> @T.F("Se quita solo en {0}.", TextoDuracion)</div>
                            <Aviso Icono="IcoInfo" Titulo="@(T["Privacidad"])">@T["No compartas datos personales de otras personas. El reporte lo verá toda la comunidad."]</Aviso>
                            @if (_mensaje != null)
                            {
                                <p class="@(_exito ? "nota exito" : "error-texto")">@T[_mensaje]</p>
                            }
                            <div class="arriba"><Boton Texto="@(_enviando ? "Enviando…" : "Enviar reporte")" Icono="IcoSend" OnClick="Enviar" /></div>
                        </Tarjeta>
                    </Secundario>
                </DosColumnas>
            </ChildContent>
        </MarcoDetalle>
        break;

    case "comentarios":
        <MarcoDetalle Categoria="@(T["Soporte"])" Titulo="@(T["Comentarios para mejorar la app"])" Subtitulo="@(T["Cuéntanos qué te gusta, qué te estorba y qué te gustaría que existiera."])">
            <ChildContent>
                <DosColumnas Lateral="316">
                    <Principal>
                        <Tarjeta Titulo="@(T["Tu opinión"])" Subtitulo="@(T["Lo leemos todo: nos ayuda a mejorar R.U.T.A."])">
                            <div class="etiquetado">
                                <label>@T["¿De qué trata?"]</label>
                                <div class="chips">
                                    @foreach (var c in Categorias)
                                    {
                                        var categoria = c;
                                        <button type="button" class="chip-radio @(_categoria == categoria.Clave ? "activo" : "")" @onclick="() => _categoria = categoria.Clave">
                                            <Icon Nombre="@categoria.Icono" Tam="13" /> @T[categoria.Texto]
                                        </button>
                                    }
                                </div>
                            </div>

                            <div class="etiquetado arriba">
                                <label>@T["¿Qué tan satisfecho estás con la app?"] <small>@T["(opcional)"]</small></label>
                                <div class="estrellas">
                                    @for (int e = 1; e <= 5; e++)
                                    {
                                        int valor = e;
                                        <button type="button" class="estrella @(_estrellas >= valor ? "llena" : "")" title="@valor" aria-label="@(valor + " / 5")" @onclick="() => _estrellas = _estrellas == valor ? 0 : valor">
                                            <Icon Nombre="IcoStar" Tam="26" />
                                        </button>
                                    }
                                </div>
                            </div>

                            <div class="etiquetado arriba">
                                <label>@T["Tu comentario"]</label>
                                <textarea class="textarea" rows="5" maxlength="600" placeholder="@(T["Por ejemplo: me gustaría ver cuánto falta para que llegue el camión."])" @bind="_comentario" @bind:event="oninput"></textarea>
                                <small class="contador-texto">@_comentario.Length/600</small>
                            </div>
                        </Tarjeta>
                    </Principal>
                    <Secundario>
                        <Tarjeta Titulo="@(T["Antes de enviar"])" Subtitulo="@(T["Solo lo ve el equipo de R.U.T.A."])">
                            <Aviso Icono="IcoInfo" Titulo="@(T["Privacidad"])">@T["No escribas contraseñas ni datos personales de otras personas."] @T[Estado.ConCuenta ? "Tu comentario se guarda con tu cuenta." : "Estás sin cuenta: el comentario se envía de forma anónima."]</Aviso>
                            @if (_mensajeOpinion != null)
                            {
                                <p class="@(_exitoOpinion ? "nota exito" : "error-texto")">@T[_mensajeOpinion]</p>
                            }
                            <div class="arriba"><Boton Texto="@(_enviandoOpinion ? T["Enviando…"] : T["Enviar comentario"])" Icono="IcoSend" OnClick="EnviarComentario" /></div>
                        </Tarjeta>
                    </Secundario>
                </DosColumnas>
            </ChildContent>
        </MarcoDetalle>
        break;

    case "ayuda":
        <MarcoDetalle Categoria="@(T["Soporte"])" Titulo="@(T["Centro de ayuda"])" Subtitulo="@(T["Respuestas rápidas sobre cómo usar R.U.T.A."])">
            <ChildContent>
                <Tarjeta Relleno="14">
                    <CampoTexto @bind-Text="_busqueda" Icono="IcoSearch" Hint="@(T["Buscar en el centro de ayuda..."])" Alto="44" />
                </Tarjeta>
                <div class="arriba-grande">
                    <Tarjeta Titulo="@(T["Preguntas frecuentes"])" Subtitulo="@(Visibles.Count() + " respuestas")">
                        @foreach (var p in Visibles)
                        {
                            var pregunta = p;
                            <div class="faq-bloque">
                                <div class="faq @(_abierta == pregunta.Pregunta ? "abierta" : "")" @onclick="() => Alternar(pregunta.Pregunta)" tabindex="0" role="button" @onkeydown="@((KeyboardEventArgs e) => { if (Teclado.EsActivacion(e)) Alternar(pregunta.Pregunta); })" aria-expanded="@(_abierta == pregunta.Pregunta)">
                                    <span>@T[pregunta.Pregunta]</span>
                                    <Icon Nombre="@(_abierta == pregunta.Pregunta ? "IcoChevronDown" : "IcoChevronRight")" Tam="15" />
                                </div>
                                @if (_abierta == pregunta.Pregunta)
                                {
                                    <p class="faq-resp anima-entra">@T[pregunta.Respuesta]</p>
                                }
                            </div>
                        }
                        @if (!Visibles.Any())
                        {
                            <p class="vacio">@T["No encontramos respuestas con ese texto."]</p>
                        }
                    </Tarjeta>
                </div>
            </ChildContent>
        </MarcoDetalle>
        break;
}

@code {
    [Parameter] public string Clave { get; set; }

    private string _tipo;
    private string _detalle = "", _mensaje;
    private int _ruta;
    private bool _enviando, _exito;

    private EstadoApp.ProblemaComun Seleccionado => EstadoApp.ProblemasComunes.FirstOrDefault(t => t.Clave == _tipo);

    // La app decide cuánto dura el aviso según el problema
    private int Dias => Seleccionado?.Dias ?? 1;
    private string TextoDuracion => Dias == 1 ? T["1 día"] : T.F("{0} días", Dias);

    private void ElegirTipo(EstadoApp.ProblemaComun t) => _tipo = t.Clave;

    private async Task Enviar()
    {
        if (_enviando) return;
        _exito = false;
        if (_tipo == null) { _mensaje = "Elige primero qué pasó."; return; }

        var tipo = EstadoApp.ProblemasComunes.First(t => t.Clave == _tipo);
        var ruta = _ruta > 0 ? Estado.BuscarRuta(_ruta) : null;
        string titulo = tipo.Texto + (ruta != null ? " en " + ruta.Nombre : "");

        _enviando = true;
        try
        {
            double[] ubicacion = tipo.Movilidad ? await Estado.UbicacionDeReporteAsync() : null;
            var (ok, error) = await Estado.PublicarAvisoAsync(titulo, string.IsNullOrWhiteSpace(_detalle) ? "Reportado desde Configuración." : _detalle.Trim(), ruta, tipo.Dias, ubicacion);
            _exito = ok;
            _mensaje = !ok ? error
                : tipo.Movilidad && ubicacion == null ? T["Tu reporte se envió, pero no pudimos tomar tu ubicación: no aparecerá marcado en el mapa."]
                : tipo.Movilidad ? T["¡Gracias! Tu reporte quedó marcado en el mapa."]
                : T["¡Gracias! Tu reporte ya es visible para la comunidad."];
            if (ok) { _tipo = null; _detalle = ""; _ruta = 0; }
        }
        finally
        {
            _enviando = false;
        }
    }

    private record CategoriaOpinion(string Clave, string Icono, string Texto);
    private static readonly CategoriaOpinion[] Categorias =
    {
        new("idea", "IcoBulb", "Una idea nueva"),
        new("mejora", "IcoWrench", "Algo por mejorar"),
        new("error", "IcoAlert", "Un error"),
        new("diseno", "IcoStar", "Diseño y facilidad de uso"),
        new("otro", "IcoInfo", "Otro")
    };

    private string _categoria = "idea", _comentario = "", _mensajeOpinion;
    private int _estrellas;
    private bool _enviandoOpinion, _exitoOpinion;

    private async Task EnviarComentario()
    {
        if (_enviandoOpinion) return;
        _exitoOpinion = false;
        string texto = _comentario.Trim();
        if (texto.Length < 10) { _mensajeOpinion = T["Escribe al menos 10 letras para que podamos entenderte."]; return; }

        _enviandoOpinion = true;
        try
        {
            int? usuario = Estado.ConCuenta ? Estado.Usuario.Id : null;
            await Opiniones.EnviarAsync(usuario, _categoria, _estrellas > 0 ? _estrellas : null, texto, T.EsIngles ? "en" : "es");
            _exitoOpinion = true;
            _mensajeOpinion = T["¡Gracias! Recibimos tu comentario."];
            _comentario = "";
            _estrellas = 0;
        }
        catch (Exception)
        {
            _mensajeOpinion = T["No se pudo enviar. Revisa la conexión con la base de datos e intenta de nuevo."];
        }
        finally
        {
            _enviandoOpinion = false;
        }
    }

    private record PreguntaAyuda(string Pregunta, string Respuesta);

    private static readonly PreguntaAyuda[] Preguntas =
    {
        new("¿Cómo planifico un viaje?", "En Planificar viaje escribe de dónde sales y a dónde vas (o toca el mapa con «Elegir en el mapa») y pulsa «Buscar y comparar rutas». Elige una opción y pulsa «Comenzar viaje» para ver los pasos."),
        new("¿Cómo guardo una ruta?", "En Rutas toca el marcador de la ruta. Guardar rutas, viajes y lugares requiere iniciar sesión; las rutas guardadas salen en tu perfil."),
        new("¿Cómo guardo mi casa o mi escuela?", "En Planificar viaje, en «Mis lugares», pulsa «Guardar un lugar»: ponle nombre y elige dónde está con «Mi ubicación», tocando el mapa o escribiendo la dirección. Después aparece como atajo para llenar origen o destino."),
        new("¿Cómo comparto un viaje?", "En Comparar rutas pulsa el icono de compartir de la opción que quieras y copia el código. Quien lo reciba lo pega en Planificar viaje → «Pegar un código» y lo ve en el mapa."),
        new("¿Cómo reporto un problema en la ruta?", "En el mapa pulsa el megáfono, elige el problema (ponchadura, se quedó tirado, tráfico…) y envía. También puedes hacerlo desde Configuración → Reportar un problema. El aviso caduca solo."),
        new("¿Por qué desaparecen algunas publicaciones?", "Las publicaciones tienen fecha de caducidad: los avisos de problemas duran pocos días para que la comunidad vea solo información vigente."),
        new("¿Cómo cambio a millas?", "En Configuración → Unidades de distancia elige millas o kilómetros; se aplica al momento."),
        new("¿Qué hago si no distingo bien los colores?", "En Configuración → Accesibilidad activa el modo daltonismo: los colores pasan a tonos neutros y cada ruta se reconoce por su símbolo y su tipo de línea."),
        new("¿Puedo usar la app con el teclado?", "Sí. Activa la Guía visual en Configuración → Accesibilidad: verás siempre dónde estás, podrás moverte con Tab, elegir con Enter y cambiar de sección con Alt + 1 a 5. También aparecen botones «?» que explican cada parte."),
        new("¿Cómo borro mi historial de viajes?", "En Mi perfil → Historial pulsa «Borrar historial»."),
        new("¿Cómo cierro sesión o borro mi cuenta?", "En Configuración → Mi cuenta. Cerrar sesión pide confirmación; borrar la cuenta pide escribir BORRAR y elimina todos tus datos.")
    };

    private string _busqueda = "", _abierta;

    private IEnumerable<PreguntaAyuda> Visibles =>
        string.IsNullOrWhiteSpace(_busqueda)
            ? Preguntas
            : Preguntas.Where(p => Formato.Coincide(p.Pregunta, _busqueda.Trim()) || Formato.Coincide(p.Respuesta, _busqueda.Trim()));

    private void Alternar(string pregunta) => _abierta = _abierta == pregunta ? null : pregunta;
}
