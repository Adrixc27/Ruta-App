@inject EstadoApp Estado

@* Ajustes → Accesibilidad: daltonismo y guía visual. Cada opción se aplica al momento en toda la app. *@
@switch (Clave)
{
    case "accesibilidad":
        <MarcoDetalle Categoria="@(T["Accesibilidad"])" Titulo="@(T["Accesibilidad"])" Subtitulo="@(T["Ajusta R.U.T.A. a tu forma de ver y de usar la app."])">
            <ChildContent>
                <DosColumnas Lateral="356">
                    <Principal>
                        <Tarjeta Titulo="@(T["Opciones"])" Subtitulo="@(T["Se aplican al momento y se recuerdan en este equipo."])">
                            <FilaAjuste Icono="IcoEye" Titulo="Modo daltonismo"
                                        Descripcion="Cambia los colores por tonos neutros. Cada ruta y parada se distingue por un símbolo y un tipo de línea distinto, no por su color.">
                                <Interruptor Activo="Datos.Daltonismo" ActivoChanged="CambiarDaltonismo" />
                            </FilaAjuste>
                            <FilaAjuste Icono="IcoLocate" Titulo="Guía visual"
                                        Descripcion="Navega con el teclado, ve siempre dónde estás y activa botones «?» que explican qué hace cada parte de la app.">
                                <Interruptor Activo="Datos.GuiaVisual" ActivoChanged="CambiarGuia" />
                            </FilaAjuste>
                            <FilaAjuste Icono="IcoZap" Titulo="@(T["Reducir animaciones"])" Descripcion="@(T["Quita los movimientos y transiciones de la interfaz."])" Linea="false">
                                <Interruptor Activo="Datos.SinAnimaciones" ActivoChanged="CambiarAnimaciones" />
                            </FilaAjuste>
                        </Tarjeta>

                        <Tarjeta Titulo="@(T["Atajos de teclado"])" Subtitulo="@(T["Con la Guía visual activa."])" Clase="separada">
                            <ParValor Etiqueta="@(T["Avanzar / retroceder"])" Valor="Tab / Mayús + Tab" />
                            <ParValor Etiqueta="@(T["Elegir lo enfocado"])" Valor="Enter o Espacio" />
                            <ParValor Etiqueta="@(T["Ir a Planificar, Rutas, Comunidad, Perfil, Configuración"])" Valor="Alt + 1 … 5" />
                            <ParValor Etiqueta="@(T["Ir al contenido de la pantalla"])" Valor="Alt + 0" Linea="false" />
                        </Tarjeta>
                    </Principal>
                    <Secundario>
                        <Tarjeta Titulo="@(T["Cómo se distinguen las rutas"])" Subtitulo="@(T["Con el modo daltonismo cada ruta tiene su símbolo y su línea."])">
                            @for (int i = 0; i < 6; i++)
                            {
                                int numero = i;
                                <div class="muestra-ruta">
                                    <span class="muestra-simbolo">@Paleta.Simbolo(numero)</span>
                                    <svg width="120" height="12" aria-hidden="true"><line x1="0" y1="6" x2="120" y2="6" stroke="currentColor" stroke-width="4" stroke-dasharray="@Paleta.Patron(numero)" /></svg>
                                    <small>@T["Ruta"] @(numero + 1)</small>
                                </div>
                            }
                        </Tarjeta>
                    </Secundario>
                </DosColumnas>
            </ChildContent>
        </MarcoDetalle>
        break;
}

@code {
    [Parameter] public string Clave { get; set; }

    private AjustesData Datos => Estado.Ajustes.Datos;

    private void CambiarDaltonismo(bool valor)
    {
        Datos.Daltonismo = valor;
        Estado.Ajustes.Guardar();
        Estado.MostrarAviso(valor ? "Modo daltonismo activado" : "Modo daltonismo desactivado");
    }

    private void CambiarGuia(bool valor)
    {
        Datos.GuiaVisual = valor;
        Estado.Ajustes.Guardar();
        Estado.MostrarAviso(valor ? "Guía visual activada: busca los botones «?»" : "Guía visual desactivada");
    }

    private void CambiarAnimaciones(bool valor)
    {
        Datos.SinAnimaciones = valor;
        Estado.Ajustes.Guardar();
        Estado.MostrarAviso(valor ? "Animaciones reducidas" : "Animaciones activadas");
    }
}
