<UserControl x:Class="Ruta_App.PlanificarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Ruta_App">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════ PANEL DE CONTROL ═══════════════ -->
        <Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderDefault}" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24">

                    <local:StepperControl Paso="1"/>

                    <StackPanel Margin="0,24,0,0">
                        <TextBlock Text="¿A dónde vas hoy?" FontSize="20" FontWeight="Black" Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="Planifica tu viaje en transporte público" FontSize="14"
                                   Foreground="{StaticResource TextSecondary}" Margin="0,6,0,0"/>
                    </StackPanel>

                    <!-- Origen / destino -->
                    <StackPanel Margin="0,24,0,0">
                        <local:CampoTexto x:Name="TxtOrigen" Punto="{StaticResource AccentOrigin}"
                                          Fondo="{StaticResource BgCard}" Hint="¿Desde dónde sales?" Margin="0,0,0,12"/>
                        <StackPanel x:Name="PanelEscalas"/>
                        <local:CampoTexto x:Name="TxtDestino" Punto="{StaticResource BrandPrimary}"
                                          Fondo="{StaticResource BgCard}" Hint="¿A dónde vas?"/>
                        <Button x:Name="BtnAnadirParada" Style="{StaticResource BtnGhost}" HorizontalAlignment="Left"
                                Padding="0,2" Margin="0,10,0,0" Click="BtnAnadirParada_Click"
                                ToolTip="Agrega un lugar por el que quieres pasar antes de llegar al destino final">
                            <TextBlock Text="+ Añadir parada intermedia"/>
                        </Button>
                        <Popup x:Name="PopSug" StaysOpen="True" AllowsTransparency="True" Placement="Bottom"
                               VerticalOffset="4" PopupAnimation="Fade">
                            <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDefault}"
                                    BorderThickness="1" CornerRadius="10" MaxHeight="300" Margin="0,0,8,8">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity=".18" Color="#1B365D"/>
                                </Border.Effect>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="ListaSug">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="Fila" Background="Transparent" Padding="12,8" Cursor="Hand"
                                                        MouseLeftButtonUp="Sugerencia_Click">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource TextPrimary}"
                                                                VerticalAlignment="Top" Margin="0,2,10,0">
                                                            <TextBlock Text="{Binding Numero}" Foreground="White" FontSize="11" FontWeight="Bold"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Nombre}" FontSize="14" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Detalle}" FontSize="12" Foreground="{StaticResource TextSecondary}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <Trigger SourceName="Fila" Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Fila" Property="Background" Value="#DBEAFE"/>
                                                    </Trigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </StackPanel>

                    <!-- Botón buscar -->
                    <TextBlock x:Name="TxtError" Text="Escribe un destino para continuar." FontSize="12"
                               Foreground="{StaticResource Danger}" Margin="0,16,0,0" Visibility="Collapsed"/>
                    <Button x:Name="BtnBuscar" Style="{StaticResource BtnPrimary}" Padding="16" FontSize="16" Margin="0,24,0,0"
                            Click="BtnBuscar_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Buscar y comparar rutas"/>
                            <local:Icon Data="{StaticResource IcoArrowRight}" Width="18" Height="18" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- Rutas recientes -->
                    <TextBlock Text="RUTAS DISPONIBLES" Style="{StaticResource LabelUpper}" Margin="0,28,0,12"/>
                    <ItemsControl x:Name="ListaRecientes">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BgCard}" CornerRadius="10" Padding="12"
                                        Margin="0,0,0,8" Cursor="Hand" MouseLeftButtonUp="Reciente_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <local:Icon Data="{StaticResource IcoClock}" Width="18" Height="18"
                                                    Foreground="{StaticResource TextSecondary}" Margin="0,0,12,0"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Ruta.Nombre}" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimary}"/>
                                            <TextBlock Text="{Binding Texto}" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource BtnIcon}" Padding="4"
                                                Click="Estrella_Click" ToolTip="Guardar ruta">
                                            <local:Icon x:Name="IcoEstrella" Data="{StaticResource IcoStar}" Width="16" Height="16"
                                                        Foreground="{StaticResource StarYellow}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Ruta.Guardada}" Value="True">
                                        <Setter TargetName="IcoEstrella" Property="Relleno" Value="{StaticResource StarYellow}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ═══════════════ MAPA ═══════════════ -->
        <local:MapaControl x:Name="Mapa" Grid.Column="1"/>
    </Grid>
</UserControl>
