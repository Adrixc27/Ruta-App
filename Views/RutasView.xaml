<UserControl x:Class="Ruta_App.RutasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Ruta_App">

    <UserControl.Resources>
        <!-- Contador dentro de las pestañas: blanco si la pestaña está activa, azul claro si no -->
        <Style x:Key="ContadorTab" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BrandTint}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="7,1"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                    <Setter Property="Background" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════ PANEL DE RUTAS ═══════════════ -->
        <Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderDefault}" BorderThickness="0,0,1,0">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Encabezado -->
                <StackPanel Grid.Row="0">
                    <TextBlock Text="Rutas de la zona" FontSize="22" FontWeight="Black" Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock x:Name="TxtSubtitulo" FontSize="14" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Pestañas Todas | Guardadas -->
                <Border Grid.Row="1" Style="{StaticResource Card}" CornerRadius="12" Padding="5" Margin="0,16,0,0">
                    <UniformGrid Columns="2">
                        <RadioButton x:Name="TabTodas" GroupName="tabs" IsChecked="True" Style="{StaticResource SegRadio}"
                                     Margin="0,0,2,0" Checked="TabTodas_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Todas"/>
                                <Border Style="{StaticResource ContadorTab}">
                                    <TextBlock x:Name="TxtCountTodas" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrandPrimary}"/>
                                </Border>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="TabGuardadas" GroupName="tabs" Style="{StaticResource SegRadio}"
                                     Margin="2,0,0,0" Checked="TabGuardadas_Checked">
                            <StackPanel Orientation="Horizontal">
                                <local:Icon Data="{StaticResource IcoBookmark}" Width="15" Height="15" Margin="0,0,6,0"/>
                                <TextBlock Text="Guardadas"/>
                                <Border Style="{StaticResource ContadorTab}">
                                    <TextBlock x:Name="TxtCountGuardadas" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrandPrimary}"/>
                                </Border>
                            </StackPanel>
                        </RadioButton>
                    </UniformGrid>
                </Border>

                <!-- Búsqueda -->
                <local:CampoTexto x:Name="Buscar" Grid.Row="2" Icono="{StaticResource IcoSearch}" Hint="Buscar ruta o colonia..."
                                  Fondo="{StaticResource BgCard}" Alto="42" Margin="0,16,0,0" TextChanged="Buscar_TextChanged"/>

                <!-- Filtros por tipo -->
                <StackPanel x:Name="PanelChips" Grid.Row="3" Orientation="Horizontal" Margin="0,16,0,0">
                    <RadioButton x:Name="ChipTodas" Content="Todas" Tag="Todas" GroupName="modo" IsChecked="True"
                                 Style="{StaticResource ChipRadio}" Margin="0,0,8,0" Checked="Modo_Checked"/>
                    <RadioButton Content="Autobús" Tag="Autobús" GroupName="modo"
                                 Style="{StaticResource ChipRadio}" Margin="0,0,8,0" Checked="Modo_Checked"/>
                    <RadioButton Content="Exprés" Tag="Exprés" GroupName="modo"
                                 Style="{StaticResource ChipRadio}" Margin="0,0,8,0" Checked="Modo_Checked"/>
                    <RadioButton Content="Metro" Tag="Metro" GroupName="modo"
                                 Style="{StaticResource ChipRadio}" Checked="Modo_Checked"/>
                </StackPanel>

                <!-- Lista -->
                <ScrollViewer Grid.Row="4" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <ItemsControl x:Name="ListaRutas">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="12" Margin="0,0,0,8" Cursor="Hand" MouseLeftButtonUp="Ruta_Click">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource BgCard}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="Padding" Value="14,12"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Seleccionada}" Value="True">
                                                        <Setter Property="Background" Value="White"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource BrandPrimary}"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                        <Setter Property="Padding" Value="13,11"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Width="40" Height="40" CornerRadius="10" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource BrandTint}"/>
                                                        <Setter Property="TextElement.Foreground" Value="{StaticResource BrandPrimary}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Seleccionada}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource BrandPrimary}"/>
                                                                <Setter Property="TextElement.Foreground" Value="White"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding NumeroTexto}" FontSize="16" FontWeight="Black"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Nombre}" FontSize="14" FontWeight="Bold"
                                                               Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                    <Border Background="{StaticResource WarningTint}" CornerRadius="5" Padding="6,1" Margin="8,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding Desvio, Converter={StaticResource BoolVis}}">
                                                        <TextBlock Text="Desvío" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Warning}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Meta}" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                                            Visibility="{Binding Seleccionada, Converter={StaticResource BoolVis}}">
                                                    <local:Icon Data="{StaticResource IcoPin}" Width="11" Height="11"
                                                                Foreground="{StaticResource BrandPrimary}"/>
                                                    <TextBlock Text="Mostrándose en el mapa" FontSize="11" FontWeight="Bold" Margin="4,0,0,0"
                                                               Foreground="{StaticResource BrandPrimary}"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <Button Grid.Column="2" Style="{StaticResource BtnIcon}" Padding="9" VerticalAlignment="Center"
                                                    Click="Marcador_Click" ToolTip="Guardar ruta">
                                                <local:Icon x:Name="IcoMarcador" Data="{StaticResource IcoBookmark}" Width="18" Height="18"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Guardada}" Value="True">
                                            <Setter TargetName="IcoMarcador" Property="Relleno" Value="{StaticResource BrandPrimary}"/>
                                            <Setter TargetName="IcoMarcador" Property="Foreground" Value="{StaticResource BrandPrimary}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Mensaje cuando no hay resultados -->
                        <TextBlock x:Name="TxtVacio" Text="No se encontraron rutas." FontSize="13" TextAlignment="Center"
                                   Foreground="{StaticResource TextSecondary}" Margin="0,16" Visibility="Collapsed"/>

                        <!-- Invitación a guardar más (solo en la pestaña Guardadas) -->
                        <Border x:Name="CtaExplorar" Style="{StaticResource Card}" CornerRadius="14" Padding="17" Margin="0,8,0,0"
                                Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center">
                                <local:Icon Data="{StaticResource IcoBookmark}" HorizontalAlignment="Center"
                                            Foreground="{StaticResource BrandPrimary}"/>
                                <TextBlock Text="Guarda más rutas" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"
                                           Foreground="{StaticResource TextPrimary}" Margin="0,8,0,0"/>
                                <TextBlock Text="Toca el marcador en cualquier ruta para agregarla aquí." FontSize="12"
                                           TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource TextSecondary}"
                                           Margin="0,6,0,0"/>
                                <Button Style="{StaticResource BtnGhost}" HorizontalAlignment="Center" Margin="0,8,0,0"
                                        Click="BtnExplorar_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Explorar todas las rutas" FontSize="12"/>
                                        <local:Icon Data="{StaticResource IcoArrowRight}" Width="14" Height="14" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <TextBlock x:Name="TxtNota" Grid.Row="5" FontSize="12" TextAlignment="Center"
                           Foreground="{StaticResource TextSecondary}" Margin="0,12,0,0"/>
            </Grid>
        </Border>

        <!-- ═══════════════ MAPA ═══════════════ -->
        <local:MapaControl x:Name="Mapa" Grid.Column="1"/>
    </Grid>
</UserControl>
