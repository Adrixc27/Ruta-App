<UserControl x:Class="Ruta_App.ComunidadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Ruta_App">

    <UserControl.Resources>
        <!-- Botón pequeño del pie de cada publicación -->
        <Style x:Key="BtnPie" TargetType="Button" BasedOn="{StaticResource BtnIcon}">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Tarjeta de publicación -->
        <DataTemplate x:Key="PlantillaPost">
            <Border Style="{StaticResource Card}" Padding="20" Margin="10" MinHeight="256">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Cabecera: avatar, autor, tipo -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="34" Height="34" CornerRadius="17" Margin="0,0,10,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource BrandPrimary}"/>
                                    <Setter Property="TextElement.Foreground" Value="White"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Oficial}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentReference}"/>
                                            <Setter Property="TextElement.Foreground" Value="{StaticResource TextPrimary}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding Inicial}" FontSize="15" FontWeight="Black"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Autor}" FontSize="13" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                <local:Icon Data="{StaticResource IcoBadgeCheck}" Width="14" Height="14" Margin="4,0,0,0"
                                            Foreground="#0D9488" VerticalAlignment="Center"
                                            Visibility="{Binding Oficial, Converter={StaticResource BoolVis}}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Tiempo}" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>

                        <Border Grid.Column="2" CornerRadius="8" Padding="8,4" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource WarningTint}"/>
                                    <Setter Property="TextElement.Foreground" Value="{StaticResource Warning}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Tipo}" Value="pregunta">
                                            <Setter Property="Background" Value="{StaticResource BrandTint}"/>
                                            <Setter Property="TextElement.Foreground" Value="{StaticResource BrandPrimary}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Tipo}" Value="propuesta">
                                            <Setter Property="Background" Value="{StaticResource SuccessTint}"/>
                                            <Setter Property="TextElement.Foreground" Value="{StaticResource Success}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <local:Icon Data="{Binding IconoTipo, Converter={StaticResource Ico}}" Width="12" Height="12"
                                            VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding TipoTexto}" FontSize="11" FontWeight="Bold" Margin="5,0,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Título, texto y etiquetas -->
                    <StackPanel Grid.Row="1" Margin="0,14,0,0">
                        <TextBlock Text="{Binding Titulo}" FontSize="18" FontWeight="Black"
                                   Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Cuerpo}" FontSize="14" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Foreground="{StaticResource TextSecondary}" LineHeight="20"
                                   LineStackingStrategy="BlockLineHeight"/>
                        <ItemsControl ItemsSource="{Binding Etiquetas}" Margin="0,10,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8" Padding="8,4" Margin="0,0,6,4" BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource BgPanel}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
                                                <Setter Property="TextElement.Foreground" Value="{StaticResource TextSecondary}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EsRuta}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource BrandTint}"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource BrandTint}"/>
                                                        <Setter Property="TextElement.Foreground" Value="{StaticResource BrandPrimary}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <local:Icon Data="{Binding Icono, Converter={StaticResource Ico}}" Width="12" Height="12"
                                                        VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Texto}" FontSize="12" FontWeight="Bold" Margin="5,0,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Pie: me gusta, comentarios, acción -->
                    <Border Grid.Row="3" BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,1,0,0"
                            Padding="0,12,0,0" Margin="0,12,0,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button Style="{StaticResource BtnPie}" Click="Like_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <local:Icon x:Name="IcoLike" Data="{StaticResource IcoHeart}" Width="16" Height="16"/>
                                        <TextBlock Text="{Binding Likes}" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource BtnPie}" Click="Comentar_Click" Margin="4,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <local:Icon Data="{StaticResource IcoMessage}" Width="16" Height="16"/>
                                        <TextBlock Text="{Binding Comentarios}" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <Button Style="{StaticResource BtnPie}" HorizontalAlignment="Right"
                                    Foreground="{StaticResource BrandPrimary}" Click="Cta_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Cta}"/>
                                    <local:Icon Data="{StaticResource IcoArrowRight}" Width="14" Height="14" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding MeGusta}" Value="True">
                    <Setter TargetName="IcoLike" Property="Relleno" Value="#EF4444"/>
                    <Setter TargetName="IcoLike" Property="Foreground" Value="#EF4444"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- ═══════════════ CONTENIDO ═══════════════ -->
        <Grid Margin="40,36,40,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Título + botón -->
            <Grid Grid.Row="0">
                <StackPanel HorizontalAlignment="Left">
                    <TextBlock Text="Comunidad" FontSize="28" FontWeight="Black" Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="Noticias, preguntas y mejoras para moverse por Chihuahua" FontSize="15"
                               Foreground="{StaticResource TextSecondary}" Margin="0,6,0,0"/>
                </StackPanel>
                <Button Style="{StaticResource BtnPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="BtnNueva_Click">
                    <StackPanel Orientation="Horizontal">
                        <local:Icon Data="{StaticResource IcoPlus}" Width="18" Height="18"/>
                        <TextBlock Text="Nueva publicación" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Aviso fijo -->
            <Border Grid.Row="1" Background="{StaticResource WarningTint}" BorderBrush="{StaticResource Warning}"
                    BorderThickness="1" CornerRadius="14" Padding="18,12" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="18" Background="White" Margin="0,0,14,0">
                        <local:Icon Data="{StaticResource IcoAlert}" Width="18" Height="18" Foreground="{StaticResource Warning}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="AVISO ACTIVO · MOVILIDAD CHIHUAHUA" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource Warning}"/>
                        <TextBlock Text="La Ruta 4 tiene un desvío temporal por obras en Zona Centro." FontSize="14"
                                   FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource BtnOutline}" Padding="14,9" FontSize="13"
                            Foreground="{StaticResource BrandPrimary}" VerticalAlignment="Center" Click="BtnVerRuta_Click">
                        <StackPanel Orientation="Horizontal">
                            <local:Icon Data="{StaticResource IcoPin}" Width="15" Height="15"/>
                            <TextBlock Text="Ver ruta afectada" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Filtros -->
            <Grid Grid.Row="2" Margin="0,16,0,6">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <RadioButton x:Name="FiltroTodo" GroupName="tipo" IsChecked="True" Tag="" Style="{StaticResource PillRadio}"
                                 Margin="0,0,8,0" Checked="Filtro_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Todo"/>
                            <TextBlock x:Name="CntTodo" FontSize="12" Opacity="0.75" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="tipo" Tag="aviso" Style="{StaticResource PillRadio}" Margin="0,0,8,0" Checked="Filtro_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource Warning}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Avisos"/>
                            <TextBlock x:Name="CntAvisos" FontSize="12" Opacity="0.75" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="tipo" Tag="pregunta" Style="{StaticResource PillRadio}" Margin="0,0,8,0" Checked="Filtro_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource BrandPrimary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Preguntas"/>
                            <TextBlock x:Name="CntPreguntas" FontSize="12" Opacity="0.75" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="tipo" Tag="propuesta" Style="{StaticResource PillRadio}" Checked="Filtro_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource Success}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Propuestas"/>
                            <TextBlock x:Name="CntPropuestas" FontSize="12" Opacity="0.75" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <local:CampoTexto x:Name="Buscar" Width="260" Icono="{StaticResource IcoSearch}"
                                      Hint="Buscar publicaciones..." Fondo="{StaticResource BgCard}"
                                      Redondeo="999" Alto="38" TextChanged="Buscar_TextChanged"/>
                    <Button x:Name="BtnOrden" Style="{StaticResource BtnOutline}" Padding="14,9" FontSize="13"
                            FontWeight="SemiBold" Background="{StaticResource BgCard}" Margin="10,0,0,0"
                            Click="BtnOrden_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtOrden" Text="Más recientes"/>
                            <local:Icon Data="{StaticResource IcoChevronDown}" Width="14" Height="14" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Feed -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Margin="-10,4,-10,0">
                <StackPanel>
                    <ItemsControl x:Name="Feed" ItemTemplate="{StaticResource PlantillaPost}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <TextBlock x:Name="TxtSinResultados" Text="No hay publicaciones que coincidan." FontSize="14"
                               Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"
                               Margin="0,24" Visibility="Collapsed"/>

                    <Button x:Name="BtnCargarMas" Style="{StaticResource BtnOutline}" Background="{StaticResource BgCard}"
                            Foreground="{StaticResource BrandPrimary}" Padding="24,11" HorizontalAlignment="Center"
                            Margin="0,4,0,8" Content="Cargar más publicaciones" Click="BtnCargarMas_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ═══════════════ MODAL: NUEVA PUBLICACIÓN ═══════════════ -->
        <Grid x:Name="Modal" Background="{StaticResource Overlay}" Visibility="Collapsed">
            <Grid Width="560" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,20">
                <Border CornerRadius="20" Background="{StaticResource BgCard}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" ShadowDepth="10" Direction="270" Opacity="0.25" Color="#1B365D"/>
                    </Border.Effect>
                </Border>
                <Border Style="{StaticResource Card}" CornerRadius="20" Padding="29">
                    <StackPanel>
                        <!-- cabecera -->
                        <Grid>
                            <StackPanel HorizontalAlignment="Left">
                                <TextBlock Text="Nueva publicación" FontSize="22" FontWeight="Black" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Comparte con la comunidad de Chihuahua" FontSize="14"
                                           Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Style="{StaticResource BtnIcon}" Background="{StaticResource BrandTint}"
                                    Foreground="{StaticResource BrandPrimary}" HorizontalAlignment="Right"
                                    VerticalAlignment="Top" Padding="9" Click="BtnCerrarModal_Click">
                                <local:Icon Data="{StaticResource IcoX}" Width="16" Height="16"/>
                            </Button>
                        </Grid>

                        <!-- tipo -->
                        <TextBlock Text="¿Qué quieres compartir?" FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondary}" Margin="0,18,0,8"/>
                        <UniformGrid Columns="3">
                            <RadioButton x:Name="TipoAviso" GroupName="nuevoTipo" Tag="aviso" Style="{StaticResource TypeOption}" Margin="0,0,5,0">
                                <StackPanel>
                                    <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource WarningTint}" HorizontalAlignment="Left">
                                        <local:Icon Data="{StaticResource IcoAlert}" Width="18" Height="18" Foreground="{StaticResource Warning}"/>
                                    </Border>
                                    <TextBlock Text="Aviso" FontSize="15" FontWeight="Black" Foreground="{StaticResource TextPrimary}" Margin="0,8,0,0"/>
                                    <TextBlock Text="Algo que afecta una ruta" FontSize="11" Foreground="{StaticResource TextSecondary}"
                                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="TipoPregunta" GroupName="nuevoTipo" Tag="pregunta" IsChecked="True"
                                         Style="{StaticResource TypeOption}" Margin="5,0">
                                <StackPanel>
                                    <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource BrandTint}" HorizontalAlignment="Left">
                                        <local:Icon Data="{StaticResource IcoHelp}" Width="18" Height="18" Foreground="{StaticResource BrandPrimary}"/>
                                    </Border>
                                    <TextBlock Text="Pregunta" FontSize="15" FontWeight="Black" Foreground="{StaticResource TextPrimary}" Margin="0,8,0,0"/>
                                    <TextBlock Text="Pide ayuda o un consejo" FontSize="11" Foreground="{StaticResource TextSecondary}"
                                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="TipoPropuesta" GroupName="nuevoTipo" Tag="propuesta" Style="{StaticResource TypeOption}" Margin="5,0,0,0">
                                <StackPanel>
                                    <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource SuccessTint}" HorizontalAlignment="Left">
                                        <local:Icon Data="{StaticResource IcoBulb}" Width="18" Height="18" Foreground="{StaticResource Success}"/>
                                    </Border>
                                    <TextBlock Text="Propuesta" FontSize="15" FontWeight="Black" Foreground="{StaticResource TextPrimary}" Margin="0,8,0,0"/>
                                    <TextBlock Text="Una mejora al servicio" FontSize="11" Foreground="{StaticResource TextSecondary}"
                                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </RadioButton>
                        </UniformGrid>

                        <!-- ruta relacionada -->
                        <StackPanel Orientation="Horizontal" Margin="0,18,0,8">
                            <TextBlock Text="Ruta relacionada" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock Text="(opcional · la verán quienes sigan esa ruta)" FontSize="11" Margin="6,0,0,0"
                                       Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button x:Name="BtnRutaSel" Style="{StaticResource BtnOutline}" Background="White"
                                HorizontalContentAlignment="Stretch" Padding="15,12" Click="BtnRutaSel_Click">
                            <Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <local:Icon Data="{StaticResource IcoBus}" Width="18" Height="18" Foreground="{StaticResource BrandPrimary}"/>
                                    <TextBlock x:Name="TxtRutaSel" Text="Sin ruta específica" FontWeight="SemiBold" FontSize="14" Margin="10,0,0,0"/>
                                </StackPanel>
                                <local:Icon Data="{StaticResource IcoChevronDown}" Width="16" Height="16" HorizontalAlignment="Right"/>
                            </Grid>
                        </Button>

                        <!-- título -->
                        <Grid Margin="0,18,0,8">
                            <TextBlock Text="Título" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock x:Name="TxtContador" Text="0/60" FontSize="11" HorizontalAlignment="Right"
                                       Foreground="{StaticResource TextSecondary}"/>
                        </Grid>
                        <TextBox x:Name="TxtTitulo" Style="{StaticResource InputBox}" MaxLength="60"
                                 Tag="Ej. ¿Qué parada necesita mejor señalización?" TextChanged="TxtTitulo_TextChanged"/>

                        <!-- mensaje -->
                        <TextBlock Text="Mensaje" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"
                                   Margin="0,18,0,8"/>
                        <TextBox x:Name="TxtMensaje" Style="{StaticResource InputBox}" Height="96" AcceptsReturn="True"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 Tag="Cuéntanos qué está pasando o qué te gustaría mejorar..."/>

                        <!-- nota -->
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <local:Icon Data="{StaticResource IcoInfo}" Width="14" Height="14" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock Text="Tu publicación será visible para toda la comunidad. Mantén un trato respetuoso."
                                       FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="8,0,0,0"/>
                        </StackPanel>

                        <TextBlock x:Name="TxtErrorModal" FontSize="12" Foreground="{StaticResource Danger}" Margin="0,10,0,0"
                                   Visibility="Collapsed"/>

                        <!-- acciones -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                            <Button Content="Cancelar" Style="{StaticResource BtnOutline}" Padding="23,12" Click="BtnCerrarModal_Click"/>
                            <Button Style="{StaticResource BtnPrimary}" Padding="22,12" FontSize="14" Margin="10,0,0,0"
                                    Click="BtnPublicar_Click">
                                <StackPanel Orientation="Horizontal">
                                    <local:Icon Data="{StaticResource IcoSend}" Width="16" Height="16"/>
                                    <TextBlock Text="Publicar" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
