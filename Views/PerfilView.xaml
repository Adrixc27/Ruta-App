<UserControl x:Class="Ruta_App.PerfilView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Ruta_App">

    <Grid>
        <!-- ═══════════════ CONTENIDO ═══════════════ -->
        <Grid Margin="40,40,40,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="Mi Perfil" FontSize="28" FontWeight="Black" Foreground="{StaticResource TextPrimary}"/>
                <TextBlock Text="Administra tu información personal y visualiza tus trayectos guardados" FontSize="15"
                           Foreground="{StaticResource TextSecondary}" Margin="0,6,0,0"/>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,32,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ─────────── Columna izquierda ─────────── -->
                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource Card}" CornerRadius="20" Padding="32">
                        <StackPanel>
                            <!-- avatar -->
                            <Border x:Name="Avatar" Width="44" Height="44" CornerRadius="22" HorizontalAlignment="Center"
                                    Background="{StaticResource BrandTint}" BorderBrush="{StaticResource BorderDefault}"
                                    BorderThickness="1">
                                <TextBlock x:Name="TxtIniciales" FontSize="16" FontWeight="Black"
                                           Foreground="{StaticResource BrandPrimary}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="TxtNombre" FontSize="20" FontWeight="Black" HorizontalAlignment="Center"
                                       Foreground="{StaticResource TextPrimary}" Margin="0,20,0,4"/>
                            <TextBlock Text="Miembro de RUTA desde 2024" FontSize="13" HorizontalAlignment="Center"
                                       Foreground="{StaticResource TextSecondary}"/>

                            <Border Height="1" Background="{StaticResource BorderSoft}" Margin="0,20,0,20"/>

                            <Grid>
                                <TextBlock Text="Correo:" FontSize="13" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="TxtCorreo" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"
                                           Foreground="{StaticResource TextPrimary}"/>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <TextBlock Text="Dispositivo:" FontSize="13" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock Text="Windows Desktop" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"
                                           Foreground="{StaticResource TextPrimary}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" CornerRadius="20" Padding="20" Margin="0,24,0,0">
                        <StackPanel>
                            <Button Content="Editar Nombre de Usuario" Style="{StaticResource BtnPrimary}" FontSize="13"
                                    Padding="16,12" Click="BtnEditarNombre_Click"/>
                            <Button Content="Cambiar Foto de Perfil" Style="{StaticResource BtnSoft}" Margin="0,12,0,0"
                                    Click="BtnCambiarFoto_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ─────────── Columna derecha: trayectos guardados ─────────── -->
                <Border Grid.Column="2" Style="{StaticResource Card}" CornerRadius="20" Padding="24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,20">
                            <TextBlock Text="Rutas Guardadas" FontSize="17" FontWeight="Black"
                                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource BtnGhost}" HorizontalAlignment="Right" Click="BtnAgregar_Click">
                                <StackPanel Orientation="Horizontal">
                                    <local:Icon Data="{StaticResource IcoPlus}" Width="16" Height="16"/>
                                    <TextBlock Text="Agregar nueva" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalAlignment="Top" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <ItemsControl x:Name="ListaTrayectos">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSoft}"
                                                    BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource BrandTint}"
                                                            Margin="0,0,16,0" VerticalAlignment="Center">
                                                        <local:Icon Data="{StaticResource IcoPin}" Width="20" Height="20"
                                                                    Foreground="{StaticResource BrandPrimary}"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Alias}" FontSize="15" FontWeight="Black"
                                                                   Foreground="{StaticResource TextPrimary}"/>
                                                        <TextBlock Text="{Binding Recorrido}" FontSize="13" FontWeight="Bold"
                                                                   Foreground="{StaticResource BrandPrimary}" Margin="0,2,0,0"/>
                                                        <TextBlock Text="{Binding Detalle}" FontSize="12"
                                                                   Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource BtnIcon}" Padding="6" Click="Favorito_Click"
                                                                ToolTip="Marcar como favorito">
                                                            <local:Icon x:Name="IcoFav" Data="{StaticResource IcoStar}" Width="18" Height="18"
                                                                        Foreground="{StaticResource StarYellow}"/>
                                                        </Button>
                                                        <Button Style="{StaticResource BtnIcon}" Padding="6" Click="Eliminar_Click"
                                                                ToolTip="Eliminar">
                                                            <local:Icon Data="{StaticResource IcoTrash}" Width="18" Height="18"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Favorito}" Value="True">
                                                    <Setter TargetName="IcoFav" Property="Relleno" Value="{StaticResource StarYellow}"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock x:Name="TxtVacio" Text="Aún no tienes trayectos guardados." FontSize="14"
                                           Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"
                                           Margin="0,32" Visibility="Collapsed"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ═══════════════ MODAL: EDITAR NOMBRE ═══════════════ -->
        <Grid x:Name="ModalNombre" Background="{StaticResource Overlay}" Visibility="Collapsed">
            <Grid Width="420" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border CornerRadius="20" Background="{StaticResource BgCard}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" ShadowDepth="10" Direction="270" Opacity="0.25" Color="#1B365D"/>
                    </Border.Effect>
                </Border>
                <Border Style="{StaticResource Card}" CornerRadius="20" Padding="28">
                    <StackPanel>
                        <TextBlock Text="Editar nombre de usuario" FontSize="20" FontWeight="Black" Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="Así te verá la comunidad en tus publicaciones." FontSize="13"
                                   Foreground="{StaticResource TextSecondary}" Margin="0,4,0,18"/>
                        <TextBox x:Name="TxtNuevoNombre" Style="{StaticResource InputBox}" MaxLength="40"
                                 Tag="Tu nombre" KeyDown="TxtNuevoNombre_KeyDown"/>
                        <TextBlock x:Name="ErrorNombre" Text="Escribe un nombre de al menos 2 letras." FontSize="12"
                                   Foreground="{StaticResource Danger}" Margin="0,8,0,0" Visibility="Collapsed"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                            <Button Content="Cancelar" Style="{StaticResource BtnOutline}" Padding="22,11" Click="BtnCancelarNombre_Click"/>
                            <Button Content="Guardar" Style="{StaticResource BtnPrimary}" Padding="22,11" FontSize="14"
                                    Margin="10,0,0,0" Click="BtnGuardarNombre_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
