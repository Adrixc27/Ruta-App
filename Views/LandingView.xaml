<UserControl x:Class="Ruta_App.LandingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Ruta_App">

    <!-- Landing page (Figma: auth-login) -->
    <Grid Background="{StaticResource BgPanel}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════ ENCABEZADO ═══════════════ -->
        <Grid Grid.Row="0" Margin="88,22,88,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"
                        Background="Transparent" Cursor="Hand" ToolTip="Ver la animación de RUTA"
                        MouseLeftButtonUp="Logo_Click">
                <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource BrandPrimary}">
                    <TextBlock Text="R" FontSize="19" FontWeight="Black" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="RUTA" FontSize="20" FontWeight="Black" Foreground="{StaticResource BrandPrimary}"/>
                    <TextBlock Text="TRANSPORTE PÚBLICO" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource BrandPrimary}" Opacity="0.85"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Rutas" Style="{StaticResource BtnGhost}" Foreground="{StaticResource TextPrimary}"
                        FontWeight="SemiBold" Padding="14,8" Margin="0,0,16,0" Click="BtnRutas_Click"/>
                <Button Content="Sobre Nosotros" Style="{StaticResource BtnPrimary}" FontSize="14" Padding="14,9"
                        Click="BtnSobre_Click"/>
            </StackPanel>
        </Grid>

        <!-- ═══════════════ CONTENIDO ═══════════════ -->
        <Grid Grid.Row="1" Margin="112,24,48,48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                <TextBlock Text="Transporte Publico en la palma de tu mano" FontSize="54" FontWeight="Black"
                           Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap"
                           LineHeight="70" LineStackingStrategy="BlockLineHeight"/>
                <TextBlock Text="Llegando a tu destino, rapido y directo." FontSize="18"
                           Foreground="{StaticResource TextPrimary}" Margin="0,22,0,0"/>

                <StackPanel Orientation="Horizontal" Margin="0,44,0,0">
                    <Button Content="Iniciar Sesion" Style="{StaticResource BtnPrimary}" FontSize="16"
                            Padding="24,17" Click="BtnLogin_Click"/>
                    <Button Content="Explorar rutas" Style="{StaticResource BtnOutline}" FontSize="16" FontWeight="Bold"
                            Foreground="{StaticResource BrandPrimary}" BorderThickness="0"
                            Padding="24,17" Margin="12,0,0,0" Click="BtnExplorar_Click"/>
                </StackPanel>
            </StackPanel>

            <!-- Tarjeta con el carrusel (mismo que en el inicio de sesión) -->
            <Border x:Name="Tarjeta" Grid.Column="1" Width="640" Height="620" CornerRadius="32" VerticalAlignment="Center"
                    BorderBrush="{StaticResource BorderDefault}" BorderThickness="1" Background="{StaticResource BgCard}">
                <local:CarruselControl x:Name="Carrusel"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
