<UserControl x:Class="Ruta_App.ConfiguracionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Ruta_App">

    <UserControl.Resources>
        <!-- Fila de ajuste con chevron -->
        <Style x:Key="AjusteItem" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource BgPanel}" CornerRadius="8" Padding="16,12">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrandTint}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="40,40,40,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Encabezado + buscador -->
        <Grid Grid.Row="0">
            <StackPanel HorizontalAlignment="Left">
                <TextBlock Text="Configuración" FontSize="28" FontWeight="Black" Foreground="{StaticResource TextPrimary}"/>
                <TextBlock Text="Personaliza tu experiencia de navegación y preferencias en RUTA" FontSize="15"
                           Foreground="{StaticResource TextSecondary}" Margin="0,6,0,0"/>
            </StackPanel>
            <local:CampoTexto x:Name="Buscar" Width="300" HorizontalAlignment="Right" VerticalAlignment="Center"
                              Icono="{StaticResource IcoSearch}" Hint="Buscar ajuste..." Fondo="{StaticResource BgCard}"
                              Redondeo="999" Alto="38" TextChanged="Buscar_TextChanged"/>
        </Grid>

        <!-- Categorías -->
        <ScrollViewer Grid.Row="1" Margin="-12,20,-12,0" VerticalAlignment="Top" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <ItemsControl x:Name="Categorias">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="24" Margin="12">
                                <StackPanel>
                                    <TextBlock Text="{Binding Titulo}" FontSize="14" FontWeight="Bold"
                                               Foreground="{StaticResource BrandPrimary}" Margin="0,0,0,16"/>
                                    <ItemsControl ItemsSource="{Binding Ajustes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource AjusteItem}" Margin="0,0,0,4" Click="Ajuste_Click">
                                                    <Grid>
                                                        <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                                        <local:Icon Data="{StaticResource IcoChevronRight}" Width="16" Height="16"
                                                                    HorizontalAlignment="Right" Foreground="{StaticResource TextSecondary}"/>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="TxtSinResultados" Text="No se encontró ningún ajuste con ese texto." FontSize="14"
                           Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"
                           Margin="0,32" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Pie -->
        <Border Grid.Row="2" Style="{StaticResource Card}" CornerRadius="14" Padding="20,16" Margin="0,16,0,0">
            <Grid>
                <TextBlock Text="RUTA v4.12.0 - Compilación de escritorio estable" FontSize="13"
                           Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                <Button Style="{StaticResource BtnGhost}" HorizontalAlignment="Right" Padding="4,2"
                        Click="BtnLegal_Click">
                    <TextBlock Text="Términos legales y licencias" FontSize="13" TextDecorations="Underline"/>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
