<Window x:Class="Ruta_App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Ruta_App"
        Title="R.U.T.A."
        Width="1440" Height="900" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgPanel}"
        FontFamily="{StaticResource Fuente}"
        Foreground="{StaticResource TextPrimary}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Grid>

        <!-- ═══════════════ APP (sidebar + pantallas) ═══════════════ -->
        <Grid x:Name="AppShell" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ───────── SIDEBAR (260 expandido / 100 colapsado) ───────── -->
            <Border x:Name="Sidebar" Grid.Column="0" Width="260" ClipToBounds="True"
                    Background="{StaticResource BgSidebar}"
                    BorderBrush="{StaticResource BorderDefault}" BorderThickness="0,0,1,0">
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Marca -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource BrandPrimary}">
                            <TextBlock Text="R" FontSize="20" FontWeight="Black" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel x:Name="PanelMarca" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="RUTA" FontSize="22" FontWeight="Black" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="TRANSPORTE PÚBLICO" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Menú -->
                    <StackPanel Grid.Row="1" Margin="0,32,0,0">
                        <TextBlock x:Name="LblMenu" Text="MENÚ" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondary}" Margin="16,0,0,8"/>

                        <Button x:Name="NavPlanificar" Style="{StaticResource NavButton}" Tag="Activo" Margin="0,0,0,8"
                                Click="Nav_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <local:Icon Data="{StaticResource IcoMap}"/>
                                <TextBlock x:Name="TxtNavPlanificar" Grid.Column="1" Text="Planificar viaje"
                                           Margin="16,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <Button x:Name="NavRutas" Style="{StaticResource NavButton}" Margin="0,0,0,8" Click="Nav_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <local:Icon Data="{StaticResource IcoRoute}"/>
                                <TextBlock x:Name="TxtNavRutas" Grid.Column="1" Text="Rutas"
                                           Margin="16,0,0,0" VerticalAlignment="Center"/>
                                <!-- Insignia con la cantidad de rutas guardadas -->
                                <Border x:Name="BadgeRutas" Grid.Column="2" CornerRadius="10" Padding="7,1"
                                        HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource BrandTint}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="Activo">
                                                    <Setter Property="Background" Value="White"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock x:Name="TxtBadgeRutas" FontSize="11" FontWeight="Bold"
                                               Foreground="{StaticResource BrandPrimary}"/>
                                </Border>
                            </Grid>
                        </Button>

                        <Button x:Name="NavComunidad" Style="{StaticResource NavButton}" Margin="0,0,0,8" Click="Nav_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <local:Icon Data="{StaticResource IcoUsers}"/>
                                <TextBlock x:Name="TxtNavComunidad" Grid.Column="1" Text="Comunidad"
                                           Margin="16,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <Button x:Name="NavPerfil" Style="{StaticResource NavButton}" Margin="0,0,0,8" Click="Nav_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <local:Icon Data="{StaticResource IcoUser}"/>
                                <TextBlock x:Name="TxtNavPerfil" Grid.Column="1" Text="Mi perfil"
                                           Margin="16,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <Button x:Name="NavConfig" Style="{StaticResource NavButton}" Margin="0,0,0,8" Click="Nav_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <local:Icon Data="{StaticResource IcoSettings}"/>
                                <TextBlock x:Name="TxtNavConfig" Grid.Column="1" Text="Configuración"
                                           Margin="16,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                    </StackPanel>

                    <!-- Parte baja: contraer menú + cerrar sesión -->
                    <StackPanel Grid.Row="2">
                        <Button x:Name="BtnColapsar" Style="{StaticResource NavButton}" Padding="16,10" FontSize="14"
                                Click="BtnColapsar_Click" ToolTip="Contraer o expandir el menú">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <local:Icon x:Name="IcoColapsar" Data="{StaticResource IcoChevronLeft}"/>
                                <TextBlock x:Name="TxtColapsar" Grid.Column="1" Text="Contraer menú"
                                           Margin="16,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <Border BorderBrush="{StaticResource BorderDefault}" BorderThickness="0,1,0,0"
                                Margin="0,12,0,0" Padding="0,16,0,0">
                            <Button x:Name="BtnLogout" Style="{StaticResource NavButton}" Padding="16,8" FontSize="14"
                                    Click="BtnLogout_Click" ToolTip="Cerrar sesión">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <local:Icon Data="{StaticResource IcoLogout}" Width="20" Height="20"/>
                                    <TextBlock x:Name="TxtLogout" Grid.Column="1" Text="Cerrar sesión"
                                               Margin="16,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ───────── ZONA DE PANTALLAS ───────── -->
            <Grid x:Name="Contenido" Grid.Column="1" Background="{StaticResource BgPanel}"/>
        </Grid>

        <!-- ═══════════════ LOGIN / REGISTRO (encima de todo) ═══════════════ -->
        <local:AuthView x:Name="Auth"/>
    </Grid>
</Window>
