<UserControl x:Class="Ruta_App.CampoTexto"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Ruta_App">
    <Border x:Name="Marco" Background="{StaticResource BgWhite}" BorderThickness="1"
            CornerRadius="12" Padding="14,0" MinHeight="46">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource BorderDefault}"/>
                <Style.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource BrandPrimary}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <local:Icon x:Name="Ico" Width="18" Height="18" Margin="0,0,12,0"
                        Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
            <Ellipse x:Name="Dot" Width="10" Height="10" Margin="0,0,12,0" Visibility="Collapsed"
                     VerticalAlignment="Center"/>

            <Grid Grid.Column="1" VerticalAlignment="Center">
                <TextBox x:Name="Caja" Background="Transparent" BorderThickness="0" Padding="0,12"
                         FontSize="14" Foreground="{StaticResource TextPrimary}"
                         CaretBrush="{StaticResource BrandPrimary}" VerticalContentAlignment="Center"/>
                <TextBlock x:Name="Placeholder" IsHitTestVisible="False" FontSize="14"
                           Foreground="{StaticResource TextSecondary}" Opacity="0.75"
                           VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
