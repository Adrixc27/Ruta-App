<UserControl x:Class="Ruta_App.SlideMarca"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Ruta_App">
    <!-- Panel azul de marca (ilustración de la ruta + titular). Es la primera diapositiva del carrusel. -->
        <Grid Background="{StaticResource BrandPrimary}" ClipToBounds="True">
            <Ellipse Width="460" Height="460" Fill="White" Opacity="0.07"
                     HorizontalAlignment="Left" VerticalAlignment="Top" Margin="380,-150,0,0"/>
            <Ellipse Width="320" Height="320" Fill="White" Opacity="0.07"
                     HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-110,0,0,-80"/>

            <Grid Margin="56">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Marca -->
                <StackPanel Orientation="Horizontal">
                    <Border Width="40" Height="40" CornerRadius="10" Background="White">
                        <TextBlock Text="R" FontSize="20" FontWeight="Black" Foreground="{StaticResource BrandPrimary}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="RUTA" FontSize="22" FontWeight="Black" Foreground="White"/>
                        <TextBlock Text="TRANSPORTE PÚBLICO" FontSize="11" FontWeight="SemiBold" Foreground="White" Opacity="0.85"/>
                    </StackPanel>
                </StackPanel>

                <!-- Ilustración de la ruta (528 x 400) -->
                <Viewbox Grid.Row="1" MaxWidth="528" Stretch="Uniform" HorizontalAlignment="Left"
                         VerticalAlignment="Center" Margin="0,24">
                    <Canvas Width="528" Height="400">
                        <!-- calles -->
                        <Polygon Points="0,300 0,282 528,250 528,268" Fill="White" Opacity="0.14"/>
                        <Polygon Points="0,150 0,138 528,110 528,122" Fill="White" Opacity="0.14"/>
                        <Polygon Points="120,0 138,0 200,400 182,400" Fill="White" Opacity="0.14"/>
                        <Polygon Points="362,0 380,0 348,400 330,400" Fill="White" Opacity="0.14"/>

                        <!-- línea de la ruta -->
                        <Path Data="M56,340 V240 Q56,219 77,219 H239 Q260,219 260,198 V101 Q260,80 281,80 H468"
                              Stroke="White" StrokeThickness="7" StrokeLineJoin="Round"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

                        <!-- paradas -->
                        <Ellipse Canvas.Left="45" Canvas.Top="329" Width="22" Height="22"
                                 Fill="{StaticResource AccentOrigin}" Stroke="White" StrokeThickness="3"/>
                        <Ellipse Canvas.Left="150" Canvas.Top="212" Width="16" Height="16" Fill="White"/>
                        <Ellipse Canvas.Left="252" Canvas.Top="142" Width="16" Height="16" Fill="White"/>
                        <Ellipse Canvas.Left="453" Canvas.Top="65" Width="30" Height="30" Fill="White"/>
                        <Ellipse Canvas.Left="462" Canvas.Top="74" Width="12" Height="12" Fill="{StaticResource BrandPrimary}"/>

                        <!-- pills -->
                        <Border Canvas.Left="84" Canvas.Top="326" Height="25" CornerRadius="8" Background="White" Padding="10,0">
                            <TextBlock Text="Tu ubicación" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource BrandPrimary}" VerticalAlignment="Center"/>
                        </Border>
                        <Border Canvas.Left="400" Canvas.Top="110" Height="25" CornerRadius="8" Background="White" Padding="10,0">
                            <TextBlock Text="Tu destino" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource BrandPrimary}" VerticalAlignment="Center"/>
                        </Border>

                        <!-- tarjeta "en vivo" -->
                        <Border Canvas.Left="232" Canvas.Top="290" Width="239" Height="68" CornerRadius="14" Background="White">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="6" Direction="270" Opacity="0.2" Color="#1B365D"/>
                            </Border.Effect>
                            <Grid>
                                <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource BrandTint}"
                                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14">
                                    <local:Icon Data="{StaticResource IcoBus}" Width="22" Height="22"
                                                Foreground="{StaticResource BrandPrimary}"/>
                                </Border>
                                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Margin="66,0,0,0">
                                    <TextBlock Text="Ruta 6 - Villas" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Llega en 4 min" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" Height="22"
                                        CornerRadius="11" Background="{StaticResource SuccessTint}" Padding="8,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="6" Height="6" Fill="{StaticResource Success}" VerticalAlignment="Center"/>
                                        <TextBlock Text="En vivo" FontSize="11" FontWeight="Bold" Margin="6,0,0,0"
                                                   Foreground="{StaticResource Success}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Canvas>
                </Viewbox>

                <!-- Texto de marca (cambia entre login y registro) -->
                <StackPanel Grid.Row="2">
                    <TextBlock x:Name="TxtTitular" FontSize="38" FontWeight="Black" Foreground="White"
                               TextWrapping="Wrap" LineHeight="44" LineStackingStrategy="BlockLineHeight"/>
                    <TextBlock x:Name="TxtSubtitular" FontSize="16" Foreground="White" Opacity="0.85"
                               TextWrapping="Wrap" LineHeight="24" LineStackingStrategy="BlockLineHeight" Margin="0,12,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>
</UserControl>
