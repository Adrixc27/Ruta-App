<UserControl x:Class="Ruta_App.MapaControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <Border Background="{StaticResource BgPage}">
        <Grid>
            <wpf:WebView2 x:Name="Web"/>
            <!-- Foto del mapa: reemplaza al WebView2 mientras hay un pop-up encima (WebView2 dibuja sobre todo lo demás) -->
            <Image x:Name="Foto" Stretch="UniformToFill" Visibility="Collapsed"/>
        </Grid>
    </Border>
</UserControl>
