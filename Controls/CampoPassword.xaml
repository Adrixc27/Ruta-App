<UserControl x:Class="Ruta_App.CampoPassword"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Ruta_App">
    <Border Background="{StaticResource BgWhite}" BorderThickness="1" CornerRadius="12"
            Padding="14,0,6,0" MinHeight="46">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource BorderDefault}"/>
                <Style.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource BrandPrimary}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <local:Icon Data="{StaticResource IcoLock}" Width="18" Height="18" Margin="0,0,12,0"
                        Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>

            <Grid Grid.Column="1" VerticalAlignment="Center">
                <PasswordBox x:Name="Oculta" Background="Transparent" BorderThickness="0" Padding="0,12"
                             FontSize="14" Foreground="{StaticResource TextPrimary}"
                             CaretBrush="{StaticResource BrandPrimary}" PasswordChanged="Oculta_PasswordChanged"/>
                <TextBox x:Name="Visible" Background="Transparent" BorderThickness="0" Padding="0,12"
                         FontSize="14" Foreground="{StaticResource TextPrimary}"
                         CaretBrush="{StaticResource BrandPrimary}" Visibility="Collapsed"
                         TextChanged="Visible_TextChanged"/>
                <TextBlock x:Name="Placeholder" Text="••••••••" IsHitTestVisible="False" FontSize="14"
                           Foreground="{StaticResource TextSecondary}" Opacity="0.75"
                           VerticalAlignment="Center"/>
            </Grid>

            <Button Grid.Column="2" Style="{StaticResource BtnIcon}" Padding="6" VerticalAlignment="Center"
                    Click="BtnOjo_Click" ToolTip="Mostrar u ocultar contraseña">
                <local:Icon Data="{StaticResource IcoEye}" Width="18" Height="18"/>
            </Button>
        </Grid>
    </Border>
</UserControl>
