<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- App de escritorio R.U.T.A.: una ventana WPF (escrita en C#, sin XAML) que aloja la interfaz Blazor
       (proyecto RutaApp.Blazor) dentro de un BlazorWebView. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Con el SDK de Windows 10.0.19041 se puede pedir la ubicación del equipo (Windows.Devices.Geolocation) -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Ruta App</AssemblyName>
    <RootNamespace>Ruta_App</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- El proyecto está en la raíz del repositorio: se listan sus archivos a mano para no recoger los de los demás proyectos -->
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs;MainWindow.cs;UbicacionWindows.cs" />
    <Content Include="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="wwwroot\index.html" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="10.0.120" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="RutaApp.Blazor\RutaApp.Blazor.csproj" />
  </ItemGroup>

</Project>
