@page "/"
@inject EstadoApp Estado

<PageTitle>R.U.T.A. · Transporte público</PageTitle>

@if (_mostrarIntro)
{
    <IntroAnimacion OnTerminada="IntroTerminada" />
}

<div class="landing">
    <header class="landing-cabecera">
        <a href="" class="marca marca-clickable" title="Ir al inicio">
            <div class="marca-logo">R</div>
            <div class="marca-texto marca-azul"><b>RUTA</b><small>TRANSPORTE PÚBLICO</small></div>
        </a>
        <nav class="landing-nav">
            <button type="button" class="btn btn-ghost-oscuro" @onclick="Explorar">Rutas</button>
            <a href="sobre-nosotros" class="btn btn-primario btn-chico">Sobre Nosotros</a>
        </nav>
    </header>

    <section class="landing-contenido">
        <div class="landing-texto">
            <h1>Transporte público en la palma de tu mano</h1>
            <p>Llegando a tu destino, rápido y directo.</p>
            <div class="landing-botones">
                @if (Estado.HaIngresado)
                {
                    <button type="button" class="btn btn-primario btn-grande" @onclick='() => Estado.Navegar("planificar")'>Abrir R.U.T.A.</button>
                }
                else
                {
                    <a href="acceso" class="btn btn-primario btn-grande">Iniciar sesión</a>
                }
                <button type="button" class="btn btn-sinborde btn-grande" @onclick="PlanificarViaje">
                    <Icon Nombre="IcoNavigation" Tam="20" /> Planificar viaje
                </button>
            </div>
        </div>

        <div class="landing-tarjeta">
            <Carrusel ConMarca="true" Titular="Muévete por tu ciudad sin perderte."
                      Subtitular="Planifica, compara y viaja en transporte público con rutas claras y en tiempo real." />
        </div>
    </section>
</div>

@code {
    private bool _mostrarIntro;

    protected override void OnInitialized()
    {
        // La animación se ve una vez al abrir la app; al terminar queda la landing
        _mostrarIntro = !Estado.IntroVista;
    }

    private void IntroTerminada()
    {
        Estado.IntroVista = true;
        _mostrarIntro = false;
        StateHasChanged();
    }

    // "Rutas": se explora la app como invitado, directo al catálogo de rutas
    private async Task Explorar()
    {
        Estado.DestinoTrasIngreso = "rutas";
        await Entrar();
    }

    // "Planificar viaje": como invitado, directo a la pantalla para planear el viaje
    private async Task PlanificarViaje()
    {
        Estado.DestinoTrasIngreso = "planificar";
        await Entrar();
    }

    private async Task Entrar()
    {
        if (!Estado.HaIngresado) Estado.EntrarComoInvitado();
        await Estado.CompletarIngresoAsync();
    }
}
