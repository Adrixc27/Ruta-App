@page "/planificar"
@layout ShellLayout
@implements IDisposable
@inject EstadoApp Estado

<PageTitle>Planificar viaje · R.U.T.A.</PageTitle>

<div class="split split-380">
    <div class="panel-lateral">
        <div class="panel-scroll">
            <Stepper Paso="1" />

            <div class="bloque">
                <h1 class="titulo-panel">¿A dónde vas hoy?</h1>
                <p class="sub-panel">Planifica tu viaje en transporte público</p>
            </div>

            @* Origen / destino / paradas intermedias *@
            <div class="bloque">
                <div class="campo-wrap">
                    <CampoTexto Text="@_origen" TextChanged="@(t => AlEscribir("origen", t))" Punto="var(--accent-origin)" Fondo="var(--bg-card)"
                                Hint="¿Desde dónde sales?" OnFocoPerdido="CerrarSugerencias" />
                    @Sugerencias("origen")
                </div>

                @foreach (var escala in _escalas)
                {
                    var e = escala;
                    <div class="campo-wrap escala">
                        <CampoTexto Text="@e.Texto" TextChanged="@(t => AlEscribir(e.Id, t))" Punto="var(--text-secondary)" Fondo="var(--bg-card)"
                                    Hint="Parada intermedia" OnFocoPerdido="CerrarSugerencias" />
                        <button type="button" class="btn-icono" title="Quitar esta parada" @onclick="() => QuitarParada(e.Id)">✕</button>
                        @Sugerencias(e.Id)
                    </div>
                }

                <div class="campo-wrap">
                    <CampoTexto Text="@_destino" TextChanged="@(t => AlEscribir("destino", t))" Punto="var(--brand-primary)" Fondo="var(--bg-card)"
                                Hint="¿A dónde vas?" OnFocoPerdido="CerrarSugerencias" />
                    @Sugerencias("destino")
                </div>

                @if (_escalas.Count < MaxParadasIntermedias)
                {
                    <button type="button" class="btn-ghost" title="Agrega un lugar por el que quieres pasar antes de llegar al destino final" @onclick="AnadirParada">+ Añadir parada intermedia</button>
                }
            </div>

            @if (_error != null)
            {
                <p class="error-texto">@_error</p>
            }
            <button type="button" class="btn btn-primario btn-ancho btn-buscar" disabled="@_buscando" @onclick="Buscar">
                Buscar y comparar rutas <Icon Nombre="IcoArrowRight" Tam="18" />
            </button>

            @* Historial de viajes *@
            <div class="label-upper">HISTORIAL DE VIAJES</div>
            <p class="nota-panel">Tus viajes anteriores y los camiones que tomaste. Con la estrella los guardas en tu perfil.</p>
            @if (Estado.Historial.Count == 0)
            {
                <p class="nota-panel">Aún no tienes viajes en tu historial.</p>
            }
            @foreach (var viaje in Estado.Historial)
            {
                var v = viaje;
                <div class="viaje-historial">
                    <Icon Nombre="IcoClock" Tam="18" Color="var(--text-secondary)" />
                    <div class="viaje-texto">
                        <b>@v.Titulo</b>
                        <span class="azul">@v.CamionesTexto</span>
                        <small>@v.Detalle</small>
                    </div>
                    <button type="button" class="btn-icono" title="Guardar viaje" @onclick="() => Estado.AlternarGuardadoHistorial(v)">
                        <Icon Nombre="IcoStar" Tam="16" Color="var(--star)" Relleno="@(v.EstaGuardado ? "var(--star)" : null)" />
                    </button>
                </div>
            }
        </div>
    </div>

    <Mapa @ref="_mapa" />
</div>

@code {
    private const int MaxParadasIntermedias = 3;

    private class Escala
    {
        public string Id = "";
        public string Texto = "";
    }

    private Mapa _mapa;
    private string _origen = EstadoApp.MiUbicacion, _destino = "";
    private readonly List<Escala> _escalas = new();
    private int _contadorEscalas;
    private string _error;
    private bool _buscando;

    private string _tipoActivo = "";                       // a qué campo pertenecen las sugerencias abiertas
    private List<Sugerencia> _sugerencias = new();
    private readonly Dictionary<string, Sugerencia> _elegido = new();   // lugar elegido por campo
    private readonly Dictionary<string, CancellationTokenSource> _esperas = new();

    protected override void OnInitialized()
    {
        // Lo que haya en Estado (por ejemplo al volver desde Comparar con "Editar búsqueda")
        _origen = string.IsNullOrWhiteSpace(Estado.Origen) ? EstadoApp.MiUbicacion : Estado.Origen;
        _destino = Estado.Destino;
        foreach (var s in Estado.Escalas)
        {
            string id = "escala" + (++_contadorEscalas);
            _escalas.Add(new Escala { Id = id, Texto = s.Nombre });
            _elegido[id] = s;
        }
        Estado.Cambio += Refrescar;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _mapa.BannerTexto("Visualizando mapa amplio de Chihuahua, Chih.");

        // Si venimos de una búsqueda anterior, se vuelven a marcar sus puntos; si no, solo "Mi ubicación actual"
        if (Estado.HayCoordenadas)
        {
            if (_origen.Equals(EstadoApp.MiUbicacion, StringComparison.OrdinalIgnoreCase)) await _mapa.MostrarMiUbicacionAsync();
            else await _mapa.ElegirUbicacion("origen", _origen, Estado.OrigenLat, Estado.OrigenLng);
            await _mapa.ElegirUbicacion("destino", _destino, Estado.DestinoLat, Estado.DestinoLng);
            for (int i = 0; i < Estado.Escalas.Count; i++)
                await _mapa.ElegirUbicacion(_escalas[i].Id, Estado.Escalas[i].Nombre, Estado.Escalas[i].Lat, Estado.Escalas[i].Lng, (i + 1).ToString());
            _elegido["origen"] = new Sugerencia { Nombre = _origen, Lat = Estado.OrigenLat, Lng = Estado.OrigenLng };
            _elegido["destino"] = new Sugerencia { Nombre = _destino, Lat = Estado.DestinoLat, Lng = Estado.DestinoLng };
        }
        else
        {
            await MarcarUbicacionAsync("origen", _origen);   // marca "Mi ubicación actual" al abrir
        }
    }

    private void Refrescar() => InvokeAsync(StateHasChanged);

    // ── Campos: origen, paradas intermedias (opcionales) y destino ────────
    private string TextoDe(string tipo) => tipo switch
    {
        "origen" => _origen,
        "destino" => _destino,
        _ => _escalas.FirstOrDefault(e => e.Id == tipo)?.Texto ?? ""
    };

    private void PonerTexto(string tipo, string texto)
    {
        if (tipo == "origen") _origen = texto;
        else if (tipo == "destino") _destino = texto;
        else { var e = _escalas.FirstOrDefault(x => x.Id == tipo); if (e != null) e.Texto = texto; }
    }

    private void AnadirParada()
    {
        if (_escalas.Count >= MaxParadasIntermedias) return;
        _escalas.Add(new Escala { Id = "escala" + (++_contadorEscalas) });
    }

    private async Task QuitarParada(string id)
    {
        _escalas.RemoveAll(e => e.Id == id);
        _elegido.Remove(id);
        if (_esperas.Remove(id, out var cts)) cts.Cancel();
        await _mapa.QuitarUbicacion(id);
        await _mapa.LimpiarSugerencias();
        _sugerencias.Clear();
        // Las paradas que quedan se renumeran en el mapa (1, 2, 3...)
        for (int i = 0; i < _escalas.Count; i++)
            if (_elegido.TryGetValue(_escalas[i].Id, out var s))
                await _mapa.ElegirUbicacion(_escalas[i].Id, s.Nombre, s.Lat, s.Lng, (i + 1).ToString());
    }

    private string EtiquetaMarcador(string tipo)
    {
        int i = _escalas.FindIndex(e => e.Id == tipo);
        return i >= 0 ? (i + 1).ToString() : "";
    }

    // ── Ubicaciones en el mapa ────────────────────────────────────────────
    // Espera a que el usuario deje de escribir (450 ms) y entonces busca lugares parecidos
    private async Task AlEscribir(string tipo, string texto)
    {
        PonerTexto(tipo, texto);
        _elegido.Remove(tipo);
        _error = null;

        if (_esperas.Remove(tipo, out var anterior)) anterior.Cancel();
        var cts = new CancellationTokenSource();
        _esperas[tipo] = cts;
        try
        {
            await Task.Delay(450, cts.Token);
        }
        catch (TaskCanceledException) { return; }

        await MarcarUbicacionAsync(tipo, texto.Trim());
        await InvokeAsync(StateHasChanged);
    }

    private async Task MarcarUbicacionAsync(string tipo, string texto)
    {
        if (texto.Length == 0)
        {
            await _mapa.QuitarUbicacion(tipo);
            await _mapa.LimpiarSugerencias();
            _sugerencias = new List<Sugerencia>();
            return;
        }

        // "Mi ubicación actual": se marca la posición real del equipo
        if (tipo == "origen" && texto.Equals(EstadoApp.MiUbicacion, StringComparison.OrdinalIgnoreCase))
        {
            await _mapa.LimpiarSugerencias();
            _sugerencias = new List<Sugerencia>();
            await _mapa.MostrarMiUbicacionAsync();
            return;
        }

        var lista = await _mapa.BuscarSugerenciasAsync(tipo, texto);
        if (lista == null) return;   // el usuario siguió escribiendo, o falló la búsqueda

        var items = new List<Sugerencia>(lista);
        if (tipo == "origen")
            items.Insert(0, new Sugerencia { Numero = "◎", Nombre = EstadoApp.MiUbicacion, Detalle = "Usar la ubicación de este equipo", Lat = double.NaN });

        _tipoActivo = tipo;
        _sugerencias = items;
    }

    private RenderFragment Sugerencias(string tipo) => @<text>
        @if (_tipoActivo == tipo && _sugerencias.Count > 0)
        {
            <div class="sugerencias">
                @foreach (var sug in _sugerencias)
                {
                    var s = sug;
                    <div class="sugerencia" @onmousedown="() => ElegirSugerencia(s)" @onmousedown:preventDefault="true">
                        <span class="sug-num">@s.Numero</span>
                        <div><b>@s.Nombre</b><small>@s.Detalle</small></div>
                    </div>
                }
            </div>
        }
    </text>;

    // El usuario elige una de las sugerencias: se escribe en el campo y se marca en el mapa
    private async Task ElegirSugerencia(Sugerencia s)
    {
        string tipo = _tipoActivo;
        if (_esperas.Remove(tipo, out var cts)) cts.Cancel();
        PonerTexto(tipo, s.Nombre);
        _sugerencias = new List<Sugerencia>();

        if (double.IsNaN(s.Lat)) { _elegido.Remove(tipo); await _mapa.MostrarMiUbicacionAsync(); }
        else { _elegido[tipo] = s; await _mapa.ElegirUbicacion(tipo, s.Nombre, s.Lat, s.Lng, EtiquetaMarcador(tipo)); }
    }

    private async Task CerrarSugerencias()
    {
        await Task.Delay(150);   // para que alcance a registrarse el clic en una sugerencia
        _sugerencias = new List<Sugerencia>();
        await InvokeAsync(StateHasChanged);
    }

    // ── Buscar ────────────────────────────────────────────────────────────
    private async Task Buscar()
    {
        _sugerencias = new List<Sugerencia>();
        string destino = _destino.Trim();
        if (destino.Length == 0)
        {
            _error = "Escribe un destino para continuar.";
            return;
        }

        _buscando = true;
        try
        {
            var o = await ResolverAsync("origen");
            if (o == null)
            {
                _error = "No pudimos ubicar tu origen. Escribe una dirección o permite la ubicación en el navegador.";
                return;
            }

            // Paradas intermedias, en el orden en que están en pantalla (las vacías se ignoran)
            var escalas = new List<Sugerencia>();
            foreach (var escala in _escalas)
            {
                string texto = escala.Texto.Trim();
                if (texto.Length == 0) continue;
                var p = await ResolverAsync(escala.Id);
                if (p == null) { _error = "No encontramos la parada \"" + texto + "\". Prueba con más detalle."; return; }
                escalas.Add(new Sugerencia { Nombre = texto, Lat = p[0], Lng = p[1] });
            }

            var d = await ResolverAsync("destino");
            if (d == null)
            {
                _error = "No encontramos ese destino. Prueba con más detalle (calle, colonia).";
                return;
            }

            _error = null;
            Estado.Origen = string.IsNullOrWhiteSpace(_origen) ? EstadoApp.MiUbicacion : _origen.Trim();
            Estado.Destino = destino;
            Estado.Escalas = escalas;
            Estado.OrigenLat = o[0]; Estado.OrigenLng = o[1];
            Estado.DestinoLat = d[0]; Estado.DestinoLng = d[1];

            Estado.Navegar("comparar");
        }
        finally
        {
            _buscando = false;
        }
    }

    /// <summary>Coordenadas [lat, lng] de lo que hay escrito en el campo, o null si no se pudo ubicar.</summary>
    private async Task<double[]> ResolverAsync(string tipo)
    {
        string texto = TextoDe(tipo).Trim();

        if (tipo == "origen" && (texto.Length == 0 || texto.Equals(EstadoApp.MiUbicacion, StringComparison.OrdinalIgnoreCase)))
        {
            await _mapa.MostrarMiUbicacionAsync();
            return _mapa.MiPosicion;
        }

        if (_elegido.TryGetValue(tipo, out var s) && s.Nombre == texto)
            return new[] { s.Lat, s.Lng };

        // No eligió de la lista: se toma el primer resultado de lo que escribió
        var lista = await _mapa.BuscarSugerenciasAsync(tipo, texto);
        if (lista == null || lista.Count == 0) return null;
        _elegido[tipo] = lista[0];
        await _mapa.ElegirUbicacion(tipo, texto, lista[0].Lat, lista[0].Lng, EtiquetaMarcador(tipo));
        return new[] { lista[0].Lat, lista[0].Lng };
    }

    public void Dispose()
    {
        Estado.Cambio -= Refrescar;
        foreach (var cts in _esperas.Values) cts.Cancel();
    }
}
