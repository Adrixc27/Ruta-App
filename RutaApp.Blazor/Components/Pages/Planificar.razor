@page "/planificar"
@layout ShellLayout
@implements IDisposable
@inject EstadoApp Estado

<PageTitle>Planificar viaje · R.U.T.A.</PageTitle>

<div class="split split-380">
    <div class="panel-lateral">
        <div class="panel-scroll">
            <div class="encabezado-seccion">
                <h1 class="titulo-seccion">¿A dónde vas hoy?<Ayuda Titulo="Planificar viaje" Texto="Escribe de dónde sales y a dónde vas (o toca «Elegir en el mapa»). También puedes buscar por el nombre de una parada. Después pulsa «Buscar y comparar rutas»." /></h1>
                <p class="sub-panel">Planifica tu viaje en transporte público</p>
            </div>

            @* Origen / destino / paradas intermedias *@
            <div class="bloque">
                <div class="campo-wrap">
                    <CampoTexto Text="@_origen" TextChanged="@(t => AlEscribir("origen", t))" Punto="var(--accent-origin)" Fondo="var(--bg-card)"
                                Hint="¿Desde dónde sales?" OnFocoPerdido="CerrarSugerencias" OnFoco='() => _campoActivo = "origen"' />
                    @Sugerencias("origen")
                </div>

                @foreach (var escala in _escalas)
                {
                    var e = escala;
                    <div class="campo-wrap escala">
                        <CampoTexto Text="@e.Texto" TextChanged="@(t => AlEscribir(e.Id, t))" Punto="var(--text-secondary)" Fondo="var(--bg-card)"
                                    Hint="Parada intermedia" OnFocoPerdido="CerrarSugerencias" OnFoco="() => _campoActivo = e.Id" />
                        <button type="button" class="btn-icono" title="Quitar esta parada" @onclick="() => QuitarParada(e.Id)">✕</button>
                        @Sugerencias(e.Id)
                    </div>
                }

                <div class="campo-wrap">
                    <CampoTexto Text="@_destino" TextChanged="@(t => AlEscribir("destino", t))" Punto="var(--brand-primary)" Fondo="var(--bg-card)"
                                Hint="¿A dónde vas?" OnFocoPerdido="CerrarSugerencias" OnFoco='() => _campoActivo = "destino"' />
                    @Sugerencias("destino")
                </div>

                <div class="acciones-campos">
                    @if (_escalas.Count < MaxParadasIntermedias)
                    {
                        <button type="button" class="btn-ghost" title="Agrega un lugar por el que quieres pasar antes de llegar al destino final" @onclick="AnadirParada">+ Añadir parada intermedia</button>
                    }
                    <button type="button" class="btn-ghost" title="Toca el mapa para poner @NombreCampoActivo" @onclick="() => EmpezarElegir(CampoParaElegir)">
                        <Icon Nombre="IcoPin" Tam="15" /> Elegir en el mapa
                    </button>
                </div>
            </div>

            @if (_error != null)
            {
                <p class="error-texto">@_error</p>
            }
            <button type="button" class="btn btn-primario btn-ancho btn-buscar" disabled="@_buscando" @onclick="Buscar">
                Buscar y comparar rutas <Icon Nombre="IcoArrowRight" Tam="18" />
            </button>

            @* Mis lugares (debajo del botón de buscar): casa, escuela y otros puntos para llenar los campos con un toque *@
            <div class="bloque lugares-rapidos">
                <div class="label-upper sin-margen">MIS LUGARES<Ayuda Titulo="Mis lugares" Texto="Guarda tu casa, escuela u otros puntos. Después, con un toque, los pones como origen o destino." /></div>

                @if (_eligiendo != null)
                {
                    <div class="eligiendo-mapa">
                        <Icon Nombre="IcoPin" Tam="18" Color="var(--brand-primary)" />
                        <span>Toca un punto del mapa para elegir el lugar.</span>
                        <button type="button" class="btn-ghost btn-mini" @onclick="CancelarElegir">Cancelar</button>
                    </div>
                }

                @if (!Estado.ConCuenta)
                {
                    <p class="nota-panel"><a href="acceso" class="azul">Inicia sesión</a> para guardar tu casa, escuela u otros lugares y planificar más rápido.</p>
                }
                else if (Estado.Lugares.Count == 0)
                {
                    <p class="nota-panel">Aún no tienes lugares. Guarda tu casa o tu escuela con el botón de abajo, o agrégalos en <a href="perfil" class="azul">Mi perfil</a>.</p>
                }
                else
                {
                    <div class="chips-lugares">
                        @foreach (var lugar in Estado.Lugares)
                        {
                            var l = lugar;
                            <span class="chip-lugar-grupo">
                                <button type="button" class="chip-lugar" title="@l.Direccion" @onclick="() => UsarLugar(l)">
                                    <Icon Nombre="@l.Icono" Tam="15" /> @l.Nombre
                                </button>
                                <button type="button" class="chip-lugar-mapa" title="Ver @l.Nombre en el mapa" @onclick="() => VerLugar(l)"><Icon Nombre="IcoMap" Tam="14" /></button>
                            </span>
                        }
                    </div>
                    <p class="nota-panel">Toca un lugar para ponerlo en el campo que estás editando (@NombreCampoActivo), o el mapa para verlo.</p>
                }

                @if (!_guardandoLugar)
                {
                    <button type="button" class="btn-ghost" @onclick="EmpezarGuardarLugar"><Icon Nombre="IcoPlus" Tam="15" /> Guardar un lugar</button>
                }
                else
                {
                    <div class="card guardar-lugar anima-entra">
                        <div class="paso-form"><span>1</span> ¿Cómo se llama?</div>
                        <CampoTexto @bind-Text="_nombreLugar" Hint="Por ejemplo: Casa, Escuela, Trabajo" MaxLength="30" Alto="40" />
                        <div class="tipos-lugar">
                            @foreach (var t in TiposLugar)
                            {
                                var tipo = t;
                                <button type="button" class="chip-radio @(_tipoLugar == tipo.Clave ? "activo" : "")" @onclick="() => _tipoLugar = tipo.Clave">
                                    <Icon Nombre="@tipo.Icono" Tam="13" /> @tipo.Texto
                                </button>
                            }
                        </div>

                        <div class="paso-form"><span>2</span> ¿Dónde está?</div>
                        <div class="lugar-opciones">
                            <button type="button" class="btn btn-contorno btn-chico" disabled="@_buscandoUbicacion" @onclick="UsarMiUbicacionLugar">
                                <Icon Nombre="IcoLocate" Tam="15" /> @(_buscandoUbicacion ? "Buscando…" : "Mi ubicación")
                            </button>
                            <button type="button" class="btn btn-contorno btn-chico" @onclick='() => EmpezarElegir("lugar")'>
                                <Icon Nombre="IcoPin" Tam="15" /> Tocar en el mapa
                            </button>
                        </div>
                        <div class="campo-wrap">
                            <CampoTexto Text="@_direccionLugar" TextChanged="BuscarDireccionLugar" Icono="IcoSearch" Hint="o escribe una dirección o lugar…" Alto="40" />
                            @if (_resultadosLugar.Count > 0)
                            {
                                <div class="sugerencias">
                                    @foreach (var sug in _resultadosLugar)
                                    {
                                        var s = sug;
                                        <div class="sugerencia" @onclick="() => ElegirDireccionLugar(s)">
                                            <span class="sug-num"><Icon Nombre="IcoPin" Tam="12" /></span>
                                            <div><b>@s.Nombre</b><small>@s.Detalle</small></div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        <div class="lugar-elegido @(LugarParaGuardar != null ? "ok" : "")">
                            @if (LugarParaGuardar != null)
                            {
                                <Icon Nombre="IcoCheckCircle" Tam="16" Color="var(--success)" /> <span>Lugar elegido: <b>@LugarParaGuardar.Nombre</b></span>
                            }
                            else
                            {
                                <span class="nota-panel">Aún no eliges dónde está el lugar.</span>
                            }
                        </div>
                        @if (_errorLugar != null) { <p class="error-texto">@_errorLugar</p> }
                        <div class="modal-acciones">
                            <button type="button" class="btn btn-contorno btn-chico" @onclick="CancelarGuardarLugar">Cancelar</button>
                            <button type="button" class="btn btn-primario btn-chico" @onclick="GuardarLugar">Guardar lugar</button>
                        </div>
                    </div>
                }
            </div>

            @* ¿Te compartieron un viaje, un lugar o una ruta? Se pega el código y se abre en el mapa (no hace falta cuenta) *@
            <div class="bloque codigo-bloque">
                <div class="label-upper sin-margen">¿TE COMPARTIERON ALGO?<Ayuda Titulo="Pegar un código" Texto="Si alguien te envió un código (RUTA1:…), pégalo aquí y verás su viaje, lugar o ruta en el mapa." /></div>
                @if (!_pegarCodigo)
                {
                    <button type="button" class="btn-ghost" @onclick="() => _pegarCodigo = true"><Icon Nombre="IcoShare" Tam="15" /> Pegar un código</button>
                }
                else
                {
                    <div class="card guardar-lugar anima-entra">
                        <CampoTexto @bind-Text="_codigoTexto" Icono="IcoShare" Hint="Pega aquí el código (RUTA1:…)" Alto="40" />
                        @if (_mensajeCodigo != null) { <p class="error-texto">@_mensajeCodigo</p> }
                        <div class="modal-acciones">
                            <button type="button" class="btn btn-contorno btn-chico" @onclick="() => { _pegarCodigo = false; _mensajeCodigo = null; }">Cancelar</button>
                            <button type="button" class="btn btn-primario btn-chico" @onclick="AbrirCodigo">Abrir</button>
                        </div>
                    </div>
                }
                @if (_viajeCompartido)
                {
                    <div class="aviso-compartido anima-entra">
                        <Icon Nombre="IcoInfo" Tam="16" />
                        <span>Estás viendo un viaje que te compartieron.</span>
                        <button type="button" class="btn-ghost btn-mini" @onclick="GuardarCompartido">Guardar en mi perfil</button>
                    </div>
                }
            </div>

            @* Historial de viajes: las rutas en las que ya viajaste *@
            <div class="label-upper">HISTORIAL DE VIAJES<Ayuda Titulo="Historial" Texto="Los viajes que ya hiciste. Toca uno para verlo otra vez en el mapa, o guárdalo con el marcador." /></div>
            @if (!Estado.ConCuenta)
            {
                <p class="nota-panel">Tu historial se guarda con tu cuenta. <a href="acceso" class="azul">Inicia sesión</a> para ver los viajes que hagas.</p>
            }
            else if (Estado.Historial.Count == 0)
            {
                <p class="nota-panel">Aún no tienes viajes en tu historial. Aquí verás las rutas en las que viajes.</p>
            }
            else
            {
                <p class="nota-panel">Toca un viaje para verlo en el mapa. Con el marcador lo guardas en tu perfil.</p>
                @foreach (var viaje in Estado.Historial.Take(10))
                {
                    var v = viaje;
                    <div class="viaje-historial @(_historialSel == v ? "sel" : "")" @onclick="() => VerHistorial(v)">
                        <Icon Nombre="IcoHistory" Tam="18" Color="var(--text-secondary)" />
                        <div class="viaje-texto">
                            <b>@v.Titulo</b>
                            <span class="azul">@v.CamionesTexto</span>
                            <small>@v.Detalle</small>
                        </div>
                        <button type="button" class="btn-icono" title="@(v.EstaGuardado ? "Quitar de guardados" : "Guardar viaje")" @onclick="() => Estado.AlternarGuardadoHistorial(v)" @onclick:stopPropagation="true">
                            <Icon Nombre="IcoBookmark" Tam="17" Color="@(v.EstaGuardado ? "var(--brand-primary)" : null)" Relleno="@(v.EstaGuardado ? "var(--brand-primary)" : null)" />
                        </button>
                    </div>
                }
                @if (Estado.Historial.Count > 10)
                {
                    <button type="button" class="btn-ghost" @onclick='() => Estado.Navegar("perfil")'>Ver todo el historial en mi perfil <Icon Nombre="IcoArrowRight" Tam="14" /></button>
                }
            }
        </div>
    </div>

    <Mapa @ref="_mapa" OnPlanificar="ReplanificarMostrado" OnClicMapa="AlClicMapa" />
</div>

@code {
    private const int MaxParadasIntermedias = 3;

    private record TipoLugar(string Clave, string Icono, string Texto);

    private static readonly TipoLugar[] TiposLugar =
    {
        new("casa", "IcoHome", "Casa"),
        new("escuela", "IcoSchool", "Escuela"),
        new("trabajo", "IcoBriefcase", "Trabajo"),
        new("otro", "IcoFlag", "Otro")
    };

    private class Escala
    {
        public string Id = "";
        public string Texto = "";
    }

    private Mapa _mapa;
    private string _origen = EstadoApp.MiUbicacion, _destino = "";
    private readonly List<Escala> _escalas = new();
    private int _contadorEscalas;
    private string _error;
    private bool _buscando;
    private string _campoActivo = "destino";

    private string _tipoActivo = "";                       // a qué campo pertenecen las sugerencias abiertas
    private List<Sugerencia> _sugerencias = new();
    private readonly Dictionary<string, Sugerencia> _elegido = new();   // lugar elegido por campo
    private readonly Dictionary<string, CancellationTokenSource> _esperas = new();

    // Viaje (del historial o del perfil) que se está viendo en el mapa
    private Ruta _viajeMostrado;
    private ViajeHistorial _historialSel;

    // Guardar el lugar elegido (casa, escuela...)
    private bool _guardandoLugar;
    private string _direccionLugar = "";
    private List<Sugerencia> _resultadosLugar = new();
    private CancellationTokenSource _esperaLugar;
    private bool _buscandoUbicacion;

    // Código que te compartieron
    private bool _pegarCodigo, _viajeCompartido;
    private string _codigoTexto = "", _mensajeCodigo, _codigoAbierto = "";

    private string _nombreLugar = "", _tipoLugar = "casa", _errorLugar;
    private Sugerencia _lugarMapa;       // lugar tocado en el mapa para guardarlo
    private string _eligiendo;           // null, "lugar" o el campo para el que se está eligiendo un punto en el mapa
    private SolicitudLugar _solicitud;   // viene del perfil: elegir un lugar tocando el mapa
    private LugarGuardado _lugarVer;     // viene del perfil: mostrar este lugar en el mapa

    private string NombreCampoActivo => _campoActivo switch
    {
        "origen" => "el origen",
        "destino" => "el destino",
        _ => "la parada intermedia"
    };

    protected override void OnInitialized()
    {
        _solicitud = Estado.TomarParametro<SolicitudLugar>();
        _lugarVer = Estado.TomarParametro<LugarGuardado>();
        _viajeMostrado = Estado.TomarParametro<Ruta>();   // por ejemplo un viaje guardado que se abre desde el perfil
        if (_solicitud != null)
        {
            _guardandoLugar = true;
            _nombreLugar = _solicitud.Nombre;
            _tipoLugar = _solicitud.Tipo;
        }

        // Lo que haya en Estado (por ejemplo al volver desde Comparar con "Editar búsqueda")
        _origen = string.IsNullOrWhiteSpace(Estado.Origen) ? EstadoApp.MiUbicacion : Estado.Origen;
        _destino = Estado.Destino;
        foreach (var s in Estado.Escalas)
        {
            string id = "escala" + (++_contadorEscalas);
            _escalas.Add(new Escala { Id = id, Texto = s.Nombre });
            _elegido[id] = s;
        }
        Estado.Cambio += Refrescar;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        if (_lugarVer != null)
        {
            _mapa.BannerTexto("Mostrando " + _lugarVer.Nombre);
            await _mapa.ElegirUbicacion("lugar", _lugarVer.Nombre, _lugarVer.Lat, _lugarVer.Lng);
            return;
        }
        if (_solicitud != null)
        {
            await EmpezarElegir("lugar");
            return;
        }

        if (_viajeMostrado != null)
        {
            await MostrarViajeAsync(_viajeMostrado, "Viaje guardado");
            return;
        }

        _mapa.BannerTexto("Visualizando mapa amplio de Chihuahua, Chih.");

        // Si venimos de una búsqueda anterior, se vuelven a marcar sus puntos; si no, solo "Mi ubicación actual"
        if (Estado.HayCoordenadas)
        {
            if (_origen.Equals(EstadoApp.MiUbicacion, StringComparison.OrdinalIgnoreCase)) await _mapa.MostrarMiUbicacionAsync();
            else await _mapa.ElegirUbicacion("origen", _origen, Estado.OrigenLat, Estado.OrigenLng);
            await _mapa.ElegirUbicacion("destino", _destino, Estado.DestinoLat, Estado.DestinoLng);
            for (int i = 0; i < Estado.Escalas.Count; i++)
                await _mapa.ElegirUbicacion(_escalas[i].Id, Estado.Escalas[i].Nombre, Estado.Escalas[i].Lat, Estado.Escalas[i].Lng, (i + 1).ToString());
            _elegido["origen"] = new Sugerencia { Nombre = _origen, Lat = Estado.OrigenLat, Lng = Estado.OrigenLng };
            _elegido["destino"] = new Sugerencia { Nombre = _destino, Lat = Estado.DestinoLat, Lng = Estado.DestinoLng };
        }
        else
        {
            await MarcarUbicacionAsync("origen", _origen);   // marca "Mi ubicación actual" al abrir
        }
    }

    private void Refrescar() => InvokeAsync(StateHasChanged);

    // ── Historial: ver un viaje anterior en el mapa ───────────────────────
    private async Task VerHistorial(ViajeHistorial v)
    {
        if (!v.TieneRecorrido)
        {
            _mapa.BannerTexto("Este viaje se hizo antes de que se guardara su recorrido.");
            return;
        }
        _historialSel = v;
        await MostrarViajeAsync(Estado.RutaDeViaje(v), "Viaje anterior · " + v.Cuando);
    }

    private async Task MostrarViajeAsync(Ruta r, string subtitulo)
    {
        _viajeMostrado = r;
        await QuitarMarcasDeBusquedaAsync();
        _mapa.BannerViaje(r.Nombre, subtitulo);
        _mapa.MostrarTarjeta(r);
        await _mapa.DibujarRuta(r);
        StateHasChanged();
    }

    // Quita del mapa el viaje que se estaba viendo (cuando el usuario empieza a escribir otra búsqueda)
    private async Task OcultarViajeMostradoAsync()
    {
        if (_viajeMostrado == null) return;
        _viajeMostrado = null;
        _historialSel = null;
        _viajeCompartido = false;
        await _mapa.LimpiarRuta();
        _mapa.OcultarTarjeta();
        _mapa.BannerTexto("Visualizando mapa amplio de Chihuahua, Chih.");
    }

    private async Task QuitarMarcasDeBusquedaAsync()
    {
        await _mapa.QuitarUbicacion("origen");
        await _mapa.QuitarUbicacion("destino");
        foreach (var e in _escalas) await _mapa.QuitarUbicacion(e.Id);
        await _mapa.LimpiarSugerencias();
    }

    // Botón de la tarjeta del viaje: vuelve a planificar el mismo origen, paradas y destino
    private async Task ReplanificarMostrado()
    {
        var r = _viajeMostrado;
        if (r == null) return;

        _origen = r.OrigenNombre;
        _destino = r.DestinoNombre;
        _elegido["origen"] = new Sugerencia { Nombre = _origen, Lat = r.LatO, Lng = r.LngO };
        _elegido["destino"] = new Sugerencia { Nombre = _destino, Lat = r.LatD, Lng = r.LngD };

        _escalas.Clear();
        foreach (var s in r.Escalas ?? new List<Sugerencia>())
        {
            string id = "escala" + (++_contadorEscalas);
            _escalas.Add(new Escala { Id = id, Texto = s.Nombre });
            _elegido[id] = s;
        }
        await Buscar();
    }

    // ── Campos: origen, paradas intermedias (opcionales) y destino ────────
    private string TextoDe(string tipo) => tipo switch
    {
        "origen" => _origen,
        "destino" => _destino,
        _ => _escalas.FirstOrDefault(e => e.Id == tipo)?.Texto ?? ""
    };

    private void PonerTexto(string tipo, string texto)
    {
        if (tipo == "origen") _origen = texto;
        else if (tipo == "destino") _destino = texto;
        else { var e = _escalas.FirstOrDefault(x => x.Id == tipo); if (e != null) e.Texto = texto; }
    }

    private void AnadirParada()
    {
        if (_escalas.Count >= MaxParadasIntermedias) return;
        _escalas.Add(new Escala { Id = "escala" + (++_contadorEscalas) });
    }

    private async Task QuitarParada(string id)
    {
        _escalas.RemoveAll(e => e.Id == id);
        _elegido.Remove(id);
        if (_esperas.Remove(id, out var cts)) cts.Cancel();
        await _mapa.QuitarUbicacion(id);
        await _mapa.LimpiarSugerencias();
        _sugerencias.Clear();
        // Las paradas que quedan se renumeran en el mapa (1, 2, 3...)
        for (int i = 0; i < _escalas.Count; i++)
            if (_elegido.TryGetValue(_escalas[i].Id, out var s))
                await _mapa.ElegirUbicacion(_escalas[i].Id, s.Nombre, s.Lat, s.Lng, (i + 1).ToString());
    }

    private string EtiquetaMarcador(string tipo)
    {
        int i = _escalas.FindIndex(e => e.Id == tipo);
        return i >= 0 ? (i + 1).ToString() : "";
    }

    // ── Mis lugares (casa, escuela...) ────────────────────────────────────
    // Pone el lugar en el campo que se estaba editando (por defecto, el destino) y lo marca en el mapa
    private async Task UsarLugar(LugarGuardado l)
    {
        await OcultarViajeMostradoAsync();
        string tipo = _campoActivo;
        if (tipo != "origen" && tipo != "destino" && !_escalas.Any(e => e.Id == tipo)) tipo = "destino";

        if (_esperas.Remove(tipo, out var cts)) cts.Cancel();
        PonerTexto(tipo, l.Nombre);
        _elegido[tipo] = new Sugerencia { Nombre = l.Nombre, Detalle = l.Direccion, Lat = l.Lat, Lng = l.Lng };
        _sugerencias = new List<Sugerencia>();
        _error = null;
        await _mapa.ElegirUbicacion(tipo, l.Nombre, l.Lat, l.Lng, EtiquetaMarcador(tipo));
    }

    // El lugar que se puede guardar es el del campo de destino (o el origen si ya se eligió una dirección)
    private Sugerencia LugarParaGuardar
    {
        get
        {
            if (_lugarMapa != null) return _lugarMapa;
            if (_elegido.TryGetValue("destino", out var d) && d.Nombre == _destino && !double.IsNaN(d.Lat)) return d;
            if (_elegido.TryGetValue("origen", out var o) && o.Nombre == _origen && !double.IsNaN(o.Lat)
                && !_origen.Equals(EstadoApp.MiUbicacion, StringComparison.OrdinalIgnoreCase)) return o;
            return null;
        }
    }

    private bool PuedeGuardarLugar
    {
        get
        {
            var s = LugarParaGuardar;
            return s != null && !Estado.Lugares.Any(l => Math.Abs(l.Lat - s.Lat) < 1e-5 && Math.Abs(l.Lng - s.Lng) < 1e-5);
        }
    }

    private void EmpezarGuardarLugar()
    {
        if (!Estado.RequiereCuenta("Inicia sesión para guardar tus lugares (casa, escuela, trabajo…).")) return;
        _nombreLugar = Estado.Lugares.Any(l => l.Tipo == "casa") ? "" : "Casa";
        _tipoLugar = _nombreLugar == "Casa" ? "casa" : "otro";
        _lugarMapa = null;
        _errorLugar = null;
        _guardandoLugar = true;
    }

    private async Task CancelarGuardarLugar()
    {
        _guardandoLugar = false;
        _direccionLugar = "";
        _resultadosLugar = new();
        _lugarMapa = null;
        _errorLugar = null;
        await CancelarElegir();
        await _mapa.QuitarUbicacion("lugar");
    }

    private async Task GuardarLugar()
    {
        var s = LugarParaGuardar;
        string nombre = _nombreLugar.Trim();
        if (nombre.Length == 0) { _errorLugar = "Ponle un nombre al lugar."; return; }
        if (s == null) { _errorLugar = "Elige el lugar: escribe una dirección o tócalo en el mapa."; return; }

        _errorLugar = null;
        Estado.AgregarLugar(nombre, _tipoLugar, s.Nombre, s.Lat, s.Lng);
        _guardandoLugar = false;
        _lugarMapa = null;
        _direccionLugar = "";
        _resultadosLugar = new();
        await _mapa.QuitarUbicacion("lugar");
    }

    // Opción 1 para ubicar el lugar: donde estás ahora
    private async Task UsarMiUbicacionLugar()
    {
        _buscandoUbicacion = true;
        _errorLugar = null;
        try
        {
            var pos = await _mapa.ActualizarPosicionAsync(true);
            if (pos == null) { _errorLugar = "No pudimos obtener tu ubicación. Revisa que el servicio de ubicación esté activo."; return; }
            string calle = await Estado.CalleDeAsync(pos[0], pos[1]);
            _lugarMapa = new Sugerencia { Nombre = string.IsNullOrWhiteSpace(calle) ? "Mi ubicación actual" : calle, Lat = pos[0], Lng = pos[1] };
            _direccionLugar = _lugarMapa.Nombre;
            _resultadosLugar = new();
        }
        finally
        {
            _buscandoUbicacion = false;
        }
    }

    // Opción 3: escribir una dirección y elegirla de la lista
    private async Task BuscarDireccionLugar(string texto)
    {
        _direccionLugar = texto;
        _lugarMapa = null;
        _esperaLugar?.Cancel();
        _esperaLugar = new CancellationTokenSource();
        var token = _esperaLugar.Token;
        try
        {
            await Task.Delay(450, token);
            if (texto.Trim().Length < 3) { _resultadosLugar = new(); return; }
            var lista = await Estado.BuscarLugaresAsync(texto.Trim());
            if (!token.IsCancellationRequested) _resultadosLugar = lista ?? new();
        }
        catch (TaskCanceledException) { }
        catch (Exception) { _resultadosLugar = new(); }
    }

    private async Task ElegirDireccionLugar(Sugerencia s)
    {
        _lugarMapa = s;
        _direccionLugar = s.Nombre;
        _resultadosLugar = new();
        _errorLugar = null;
        await _mapa.ElegirUbicacion("lugar", s.Nombre, s.Lat, s.Lng);
    }

    // ── Código que te compartieron ────────────────────────────────────────
    private async Task AbrirCodigo()
    {
        var c = CodigoCompartir.Leer(_codigoTexto);
        if (c == null)
        {
            _mensajeCodigo = "Ese código no es válido. Cópialo completo; empieza con \"" + CodigoCompartir.Prefijo + "\".";
            return;
        }
        _mensajeCodigo = null;
        _codigoAbierto = _codigoTexto;
        _pegarCodigo = false;
        _viajeCompartido = false;

        switch (c.Tipo)
        {
            case "viaje" when c.Viaje != null:
                _viajeCompartido = true;
                await MostrarViajeAsync(Estado.RutaDeViaje(c.Viaje), "Viaje compartido");
                break;
            case "lugar" when c.Lugar != null:
                await OcultarViajeMostradoAsync();
                PonerTexto("destino", c.Lugar.Nombre);
                _elegido["destino"] = new Sugerencia { Nombre = c.Lugar.Nombre, Detalle = c.Lugar.Direccion, Lat = c.Lugar.Lat, Lng = c.Lugar.Lng };
                await _mapa.ElegirUbicacion("destino", c.Lugar.Nombre, c.Lugar.Lat, c.Lugar.Lng);
                Estado.MostrarAviso("Lugar compartido puesto como destino");
                break;
            case "ruta":
                var ruta = Estado.BuscarRuta(c.RutaId);
                if (ruta == null) { _mensajeCodigo = "Esa ruta no está disponible ahora."; _pegarCodigo = true; }
                else Estado.Navegar("rutas", ruta);
                break;
        }
    }

    // Guarda en el perfil lo que te compartieron (pide cuenta)
    private void GuardarCompartido()
    {
        string mensaje = Estado.ImportarCodigo(_codigoAbierto);
        if (!string.IsNullOrEmpty(mensaje)) Estado.MostrarAviso(mensaje);
    }

    // Muestra un lugar guardado en el mapa
    private async Task VerLugar(LugarGuardado l)
    {
        await OcultarViajeMostradoAsync();
        _mapa.BannerTexto("Mostrando " + l.Nombre);
        await _mapa.ElegirUbicacion("lugar", l.Nombre, l.Lat, l.Lng);
    }

    // ── Elegir un punto tocando el mapa ───────────────────────────────────
    private string CampoParaElegir =>
        _campoActivo == "origen" || _campoActivo == "destino" || _escalas.Any(e => e.Id == _campoActivo) ? _campoActivo : "destino";

    private async Task EmpezarElegir(string objetivo)
    {
        if (objetivo == "lugar" && !Estado.RequiereCuenta("Inicia sesión para guardar tus lugares (casa, escuela, trabajo…).")) return;
        _eligiendo = objetivo;
        _mapa.BannerTexto("Toca el mapa para elegir el lugar");
        await _mapa.ActivarSeleccionAsync(true);
        StateHasChanged();
    }

    private async Task CancelarElegir()
    {
        if (_eligiendo == null) return;
        _eligiendo = null;
        await _mapa.ActivarSeleccionAsync(false);
        _mapa.BannerTexto("Visualizando mapa amplio de Chihuahua, Chih.");
    }

    // El usuario tocó el mapa: el punto se usa como lugar a guardar o como origen, parada o destino
    private async Task AlClicMapa(double[] pos)
    {
        string objetivo = _eligiendo;
        if (objetivo == null) return;
        _eligiendo = null;
        await _mapa.ActivarSeleccionAsync(false);

        string nombre = await Estado.CalleDeAsync(pos[0], pos[1]);
        if (string.IsNullOrWhiteSpace(nombre)) nombre = "Lugar elegido en el mapa";
        var sug = new Sugerencia { Nombre = nombre, Lat = pos[0], Lng = pos[1] };

        if (objetivo == "lugar")
        {
            _lugarMapa = sug;
            _guardandoLugar = true;
            _errorLugar = null;
            await _mapa.ElegirUbicacion("lugar", nombre, pos[0], pos[1]);
        }
        else
        {
            await OcultarViajeMostradoAsync();
            PonerTexto(objetivo, nombre);
            _elegido[objetivo] = sug;
            _error = null;
            await _mapa.ElegirUbicacion(objetivo, nombre, pos[0], pos[1], EtiquetaMarcador(objetivo));
        }
        _mapa.BannerTexto("Lugar elegido: " + nombre);
        StateHasChanged();
    }

    // ── Ubicaciones en el mapa ────────────────────────────────────────────
    // Espera a que el usuario deje de escribir (450 ms) y entonces busca lugares parecidos
    private async Task AlEscribir(string tipo, string texto)
    {
        await OcultarViajeMostradoAsync();
        PonerTexto(tipo, texto);
        _elegido.Remove(tipo);
        _guardandoLugar = false;
        _error = null;

        if (_esperas.Remove(tipo, out var anterior)) anterior.Cancel();
        var cts = new CancellationTokenSource();
        _esperas[tipo] = cts;
        try
        {
            await Task.Delay(450, cts.Token);
        }
        catch (TaskCanceledException) { return; }

        await MarcarUbicacionAsync(tipo, texto.Trim());
        await InvokeAsync(StateHasChanged);
    }

    private async Task MarcarUbicacionAsync(string tipo, string texto)
    {
        if (texto.Length == 0)
        {
            await _mapa.QuitarUbicacion(tipo);
            await _mapa.LimpiarSugerencias();
            _sugerencias = new List<Sugerencia>();
            return;
        }

        // "Mi ubicación actual": se marca la posición real del equipo
        if (tipo == "origen" && texto.Equals(EstadoApp.MiUbicacion, StringComparison.OrdinalIgnoreCase))
        {
            await _mapa.LimpiarSugerencias();
            _sugerencias = new List<Sugerencia>();
            await _mapa.MostrarMiUbicacionAsync();
            return;
        }

        var lista = await _mapa.BuscarSugerenciasAsync(tipo, texto);
        if (lista == null) return;   // el usuario siguió escribiendo, o falló la búsqueda

        var items = new List<Sugerencia>(lista);
        // Paradas de camión que coinciden con lo escrito (buscar por paradas)
        foreach (var parada in Estado.BuscarParadas(texto, 4).AsEnumerable().Reverse())
            items.Insert(0, new Sugerencia { Numero = "P", Nombre = parada.Nombre, Detalle = "Parada · " + parada.RutaNombre, Lat = parada.Lat, Lng = parada.Lng });
        // Los lugares guardados que coinciden con lo escrito salen primero
        foreach (var l in Estado.Lugares.Where(l => l.Nombre.Contains(texto, StringComparison.CurrentCultureIgnoreCase)).Reverse())
            items.Insert(0, new Sugerencia { Numero = "★", Nombre = l.Nombre, Detalle = "Mi lugar · " + l.TipoTexto, Lat = l.Lat, Lng = l.Lng });
        if (tipo == "origen")
            items.Insert(0, new Sugerencia { Numero = "◎", Nombre = EstadoApp.MiUbicacion, Detalle = "Usar la ubicación de este equipo", Lat = double.NaN });

        _tipoActivo = tipo;
        _sugerencias = items;
    }

    private RenderFragment Sugerencias(string tipo) => @<text>
        @if (_tipoActivo == tipo && _sugerencias.Count > 0)
        {
            <div class="sugerencias">
                @foreach (var sug in _sugerencias)
                {
                    var s = sug;
                    <div class="sugerencia" @onmousedown="() => ElegirSugerencia(s)" @onmousedown:preventDefault="true">
                        <span class="sug-num">@s.Numero</span>
                        <div><b>@s.Nombre</b><small>@s.Detalle</small></div>
                    </div>
                }
            </div>
        }
    </text>;

    // El usuario elige una de las sugerencias: se escribe en el campo y se marca en el mapa
    private async Task ElegirSugerencia(Sugerencia s)
    {
        string tipo = _tipoActivo;
        if (_esperas.Remove(tipo, out var cts)) cts.Cancel();
        PonerTexto(tipo, s.Nombre);
        _sugerencias = new List<Sugerencia>();

        if (double.IsNaN(s.Lat)) { _elegido.Remove(tipo); await _mapa.MostrarMiUbicacionAsync(); }
        else { _elegido[tipo] = s; await _mapa.ElegirUbicacion(tipo, s.Nombre, s.Lat, s.Lng, EtiquetaMarcador(tipo)); }
    }

    private async Task CerrarSugerencias()
    {
        await Task.Delay(150);   // para que alcance a registrarse el clic en una sugerencia
        _sugerencias = new List<Sugerencia>();
        await InvokeAsync(StateHasChanged);
    }

    // ── Buscar ────────────────────────────────────────────────────────────
    private async Task Buscar()
    {
        _sugerencias = new List<Sugerencia>();
        string destino = _destino.Trim();
        if (destino.Length == 0)
        {
            _error = "Escribe un destino para continuar.";
            return;
        }

        _buscando = true;
        try
        {
            var o = await ResolverAsync("origen");
            if (o == null)
            {
                _error = "No pudimos ubicar tu origen. Escribe una dirección o permite la ubicación en el navegador.";
                return;
            }

            // Paradas intermedias, en el orden en que están en pantalla (las vacías se ignoran)
            var escalas = new List<Sugerencia>();
            foreach (var escala in _escalas)
            {
                string texto = escala.Texto.Trim();
                if (texto.Length == 0) continue;
                var p = await ResolverAsync(escala.Id);
                if (p == null) { _error = "No encontramos la parada \"" + texto + "\". Prueba con más detalle."; return; }
                escalas.Add(new Sugerencia { Nombre = texto, Lat = p[0], Lng = p[1] });
            }

            var d = await ResolverAsync("destino");
            if (d == null)
            {
                _error = "No encontramos ese destino. Prueba con más detalle (calle, colonia).";
                return;
            }

            _error = null;
            Estado.Origen = string.IsNullOrWhiteSpace(_origen) ? EstadoApp.MiUbicacion : _origen.Trim();
            Estado.Destino = destino;
            Estado.Escalas = escalas;
            Estado.OrigenLat = o[0]; Estado.OrigenLng = o[1];
            Estado.DestinoLat = d[0]; Estado.DestinoLng = d[1];

            Estado.Navegar("comparar");
        }
        finally
        {
            _buscando = false;
        }
    }

    /// <summary>Coordenadas [lat, lng] de lo que hay escrito en el campo, o null si no se pudo ubicar.</summary>
    private async Task<double[]> ResolverAsync(string tipo)
    {
        string texto = TextoDe(tipo).Trim();

        if (tipo == "origen" && (texto.Length == 0 || texto.Equals(EstadoApp.MiUbicacion, StringComparison.OrdinalIgnoreCase)))
        {
            await _mapa.MostrarMiUbicacionAsync();
            return _mapa.MiPosicion;
        }

        if (_elegido.TryGetValue(tipo, out var s) && s.Nombre == texto)
            return new[] { s.Lat, s.Lng };

        // No eligió de la lista: se toma el primer resultado de lo que escribió
        var lista = await _mapa.BuscarSugerenciasAsync(tipo, texto);
        if (lista == null || lista.Count == 0) return null;
        _elegido[tipo] = lista[0];
        await _mapa.ElegirUbicacion(tipo, texto, lista[0].Lat, lista[0].Lng, EtiquetaMarcador(tipo));
        return new[] { lista[0].Lat, lista[0].Lng };
    }

    public void Dispose()
    {
        Estado.Cambio -= Refrescar;
        foreach (var cts in _esperas.Values) cts.Cancel();
        _esperaLugar?.Cancel();
    }
}
