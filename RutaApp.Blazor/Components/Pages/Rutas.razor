@page "/rutas"
@layout ShellLayout
@implements IDisposable
@inject EstadoApp Estado

<PageTitle>Rutas · R.U.T.A.</PageTitle>

<div class="split split-400">
    <div class="panel-lateral panel-rutas">
        <div>
            <h1 class="titulo-panel grande">Rutas de la zona<Ayuda Titulo="Rutas de la zona" Texto="Aquí ves todas las rutas de camión. Toca una para verla en el mapa, con sus paradas y más detalles. Con el marcador la guardas en tu perfil (requiere sesión)." /></h1>
            <p class="sub-panel">@(_soloGuardadas ? "Tus rutas guardadas, siempre a un toque" : "Toca una ruta para verla en el mapa")</p>
        </div>

        @* Pestañas Todas | Guardadas *@
        <div class="card pestanas">
            <button type="button" class="seg @(!_soloGuardadas ? "activo" : "")" @onclick="() => CambiarPestana(false)">
                Todas <em class="contador">@Estado.Rutas.Count</em>
            </button>
            <button type="button" class="seg @(_soloGuardadas ? "activo" : "")" @onclick="() => CambiarPestana(true)">
                <Icon Nombre="IcoBookmark" Tam="15" /> Guardadas <em class="contador">@Estado.TotalGuardadas</em>
            </button>
        </div>

        <div class="busqueda-panel">
            <Ayuda Titulo="Buscar" Texto="Escribe el nombre de una ruta, una colonia o una parada. Las rutas que pasan por esa parada aparecen con el nombre de la parada coincidente." />
            <CampoTexto Text="@_busqueda" TextChanged="AlBuscar" Icono="IcoSearch" Hint="Buscar ruta, colonia o parada..." Fondo="var(--bg-card)" Alto="42" />
        </div>

        <div class="lista-rutas">
            @if (_soloGuardadas && !Estado.ConCuenta)
            {
                <div class="card invitacion">
                    <Icon Nombre="IcoLock" Color="var(--brand-primary)" />
                    <b>Inicia sesión para guardar rutas</b>
                    <small>Con tu cuenta puedes guardar las rutas que más usas y verlas también en tu perfil.</small>
                    <a href="acceso" class="btn-ghost">Iniciar sesión <Icon Nombre="IcoArrowRight" Tam="14" /></a>
                </div>
            }
            else
            {
                @foreach (var ruta in Visibles)
                {
                    var r = ruta;
                    <div class="ruta-item @(r.Seleccionada ? "sel" : "")" style="--c:@r.Color" @onclick="() => Seleccionar(r)">
                        <span class="ruta-numero">@r.NumeroTexto<span class="simbolo-ruta" aria-hidden="true">@r.Simbolo</span></span>
                        <div class="ruta-texto">
                            <div class="ruta-nombre">
                                <b>@r.Nombre</b>
                                @if (r.Desvio) { <span class="etiqueta-desvio">Desvío</span> }
                                @if (r.TieneVariantes) { <span class="etiqueta-variantes">@r.Variantes.Count variantes</span> }
                            </div>
                            <small>@r.Paradas paradas · @Formato.Distancia(r.Kilometros * 1000) · @r.TarifaTexto</small>
                            @if (_busqueda.Trim().Length >= 3 && Estado.ParadaQueCoincide(r, _busqueda) is string parada)
                            {
                                <span class="parada-coincide"><Icon Nombre="IcoPin" Tam="11" /> Parada: @parada</span>
                            }
                            @if (r.Seleccionada)
                            {
                                <span class="en-mapa"><Icon Nombre="IcoPin" Tam="11" /> Mostrándose en el mapa</span>
                            }
                        </div>
                        <button type="button" class="btn-icono" title="Compartir ruta" @onclick="() => Compartir(r)" @onclick:stopPropagation="true">
                            <Icon Nombre="IcoShare" Tam="17" />
                        </button>
                        <button type="button" class="btn-icono" title="@(r.Guardada ? "Quitar de guardadas" : "Guardar ruta")" @onclick="() => Estado.AlternarGuardada(r)" @onclick:stopPropagation="true">
                            <Icon Nombre="IcoBookmark" Tam="18" Color="@(r.Guardada ? "var(--brand-primary)" : null)" Relleno="@(r.Guardada ? "var(--brand-primary)" : null)" />
                        </button>
                    </div>
                }

                @if (Estado.Rutas.Count == 0)
                {
                    <div class="card invitacion">
                        <Icon Nombre="IcoAlert" Color="var(--warning)" />
                        <b>No pudimos cargar las rutas</b>
                        <small>@(Estado.ErrorBaseDatos ?? "Revisa que MySQL esté encendido y vuelve a intentar.")</small>
                        <button type="button" class="btn-ghost" @onclick="Estado.ReintentarRutasAsync"><Icon Nombre="IcoRefresh" Tam="14" /> Reintentar</button>
                        <button type="button" class="btn-ghost" @onclick='() => Estado.Navegar("ajuste", "Conexión a la base de datos")'><Icon Nombre="IcoSettings" Tam="14" /> Configurar la conexión</button>
                    </div>
                }
                else if (!Visibles.Any())
                {
                    <p class="vacio">@(_soloGuardadas ? "Aún no tienes rutas guardadas." : "No se encontraron rutas.")</p>
                }

                @if (_soloGuardadas && Estado.Rutas.Count > 0)
                {
                    <div class="card invitacion">
                        <Icon Nombre="IcoBookmark" Color="var(--brand-primary)" />
                        <b>Guarda más rutas</b>
                        <small>Toca el marcador en cualquier ruta para agregarla aquí.</small>
                        <button type="button" class="btn-ghost" @onclick="() => CambiarPestana(false)">Explorar todas las rutas <Icon Nombre="IcoArrowRight" Tam="14" /></button>
                    </div>
                }
            }
        </div>

        <p class="nota-pie">@(_soloGuardadas || Estado.Rutas.Count == 0 ? "" : "Mostrando " + Visibles.Count() + " de " + Estado.Rutas.Count + " rutas")</p>
    </div>

    <Mapa @ref="_mapa" OnQuitar="QuitarSeleccion" OnPlanificar="PlanificarConRuta" OnGuardar="GuardarSeleccion" />
</div>

<CompartirDialogo @bind-Visible="_compartir" Titulo="@_tituloCompartir" Codigo="@_codigo" />

@code {
    private Mapa _mapa;
    private bool _soloGuardadas;
    private string _busqueda = "";
    private Ruta _seleccion;
    private Ruta _pedida;   // ruta que otra pantalla quiere ver en el mapa
    private bool _compartir;
    private string _tituloCompartir = "", _codigo = "";

    private IEnumerable<Ruta> Visibles
    {
        get
        {
            IEnumerable<Ruta> lista = _soloGuardadas ? Estado.Rutas.Where(r => r.Guardada) : Estado.Rutas;
            string q = _busqueda.Trim();
            if (q.Length > 0)
            {
                lista = lista.Where(r =>
                    r.Nombre.Contains(q, StringComparison.CurrentCultureIgnoreCase) ||
                    r.OrigenNombre.Contains(q, StringComparison.CurrentCultureIgnoreCase) ||
                    r.DestinoNombre.Contains(q, StringComparison.CurrentCultureIgnoreCase) ||
                    Estado.ParadaQueCoincide(r, q) != null);   // también por el nombre de una parada
            }
            return lista;
        }
    }

    protected override void OnInitialized()
    {
        // Llegamos desde otra pantalla pidiendo ver una ruta concreta (por ejemplo Comunidad → "Ver en el mapa")
        _pedida = Estado.TomarParametro<Ruta>();
        _seleccion = _pedida ?? Estado.RutaSeleccionada;   // no se dibuja nada hasta que se elige una ruta
        Estado.Cambio += Refrescar;
        _ = Estado.CargarPublicacionesAsync();               // avisos de la comunidad que salen como alertas en la ruta
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (_seleccion == null)
        {
            _mapa.BannerTexto("Elige una ruta de la lista para verla en el mapa");
            return;
        }
        await Seleccionar(_seleccion);
        StateHasChanged();   // para que la lista marque la ruta seleccionada
    }

    // Si la ruta que se ve en el mapa cambió de "guardada", se actualiza su tarjeta
    private void Refrescar()
    {
        InvokeAsync(() =>
        {
            if (_seleccion != null) _mapa?.MostrarTarjeta(_seleccion);
            StateHasChanged();
        });
    }

    private void CambiarPestana(bool soloGuardadas) => _soloGuardadas = soloGuardadas;

    private void AlBuscar(string texto) => _busqueda = texto;

    // ── Selección y mapa ──────────────────────────────────────────────────
    private async Task Seleccionar(Ruta r)
    {
        foreach (var x in Estado.Rutas) x.Seleccionada = (x == r);
        _seleccion = r;
        Estado.RutaSeleccionada = r;
        _mapa.BannerRuta("Mostrando " + r.Nombre, true);
        _mapa.MostrarTarjeta(r);
        await _mapa.DibujarRuta(r);
    }

    // Botón "Quitar" del banner del mapa
    private async Task QuitarSeleccion()
    {
        foreach (var x in Estado.Rutas) x.Seleccionada = false;
        _seleccion = null;
        Estado.RutaSeleccionada = null;
        await _mapa.LimpiarRuta();
        _mapa.OcultarTarjeta();
        _mapa.BannerTexto("Elige una ruta de la lista para verla en el mapa");
    }

    // Botón "Planificar viaje con esta ruta" de la tarjeta del mapa
    private void PlanificarConRuta()
    {
        if (_seleccion == null) return;
        Estado.Origen = _seleccion.OrigenNombre;
        Estado.Destino = _seleccion.DestinoNombre;
        Estado.Escalas = new List<Sugerencia>();
        Estado.OrigenLat = double.NaN;
        Estado.DestinoLat = double.NaN;
        Estado.Navegar("planificar");
    }

    // Botón "Guardada" de la tarjeta del mapa
    private void GuardarSeleccion()
    {
        if (_seleccion != null) Estado.AlternarGuardada(_seleccion);
    }

    private void Compartir(Ruta r)
    {
        _tituloCompartir = "Ruta " + r.Nombre;
        _codigo = CodigoCompartir.Crear(new Compartido { Tipo = "ruta", RutaId = r.Numero, RutaNombre = r.Nombre });
        _compartir = true;
    }

    public void Dispose() => Estado.Cambio -= Refrescar;
}
