<button type="button" class="btn @(Relleno ? "btn-primario" : "btn-contorno") btn-ajuste" @onclick="() => OnClick.InvokeAsync()">
    @if (Icono != null)
    {
        <Icon Nombre="@Icono" Tam="17" />
    }
    <span>@Texto</span>
</button>

@code {
    [Parameter] public string Texto { get; set; }
    [Parameter] public string Icono { get; set; }
    [Parameter] public bool Relleno { get; set; } = true;
    [Parameter] public EventCallback OnClick { get; set; }
}
