@inject EstadoApp Estado

@* Ajustes → Soporte: reportar un problema (se publica como aviso en la comunidad) y centro de ayuda con respuestas. *@
@switch (Clave)
{
    case "reportar":
        <MarcoDetalle Categoria="Soporte" Titulo="Reportar un problema en la ruta" Subtitulo="Avisa a los demás: tu reporte aparece como aviso en la comunidad y se quita solo cuando caduca.">
            <ChildContent>
                <DosColumnas Lateral="316">
                    <Principal>
                        <Tarjeta Titulo="¿Qué pasó?" Subtitulo="Elige el problema y, si quieres, cuéntanos más.">
                            <div class="reporte-tipos">
                                @foreach (var t in EstadoApp.ProblemasComunes)
                                {
                                    var tipo = t;
                                    <button type="button" class="reporte-tipo @(_tipo == tipo.Clave ? "sel" : "")" @onclick="() => ElegirTipo(tipo)">
                                        <Icon Nombre="@tipo.Icono" Tam="20" /><span>@tipo.Texto</span>
                                    </button>
                                }
                            </div>

                            <div class="etiquetado arriba-grande">
                                <label>Ruta afectada <small>(opcional)</small></label>
                                <div class="select-ruta">
                                    <Icon Nombre="IcoBus" Tam="18" Color="var(--brand-primary)" />
                                    <select @bind="_ruta">
                                        <option value="0">Sin ruta específica</option>
                                        @foreach (var r in Estado.Rutas)
                                        {
                                            <option value="@r.Numero">@r.Nombre</option>
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="etiquetado arriba">
                                <label>Detalles <small>(opcional)</small></label>
                                <textarea class="textarea" rows="3" maxlength="400" placeholder="Por ejemplo: en Av. Universidad, el camión tiene una llanta ponchada." @bind="_detalle" @bind:event="oninput"></textarea>
                            </div>

                            <div class="etiquetado arriba">
                                <label>¿Cuánto tiempo sigue siendo útil el aviso?</label>
                                <div class="chips">
                                    @foreach (var d in Duraciones)
                                    {
                                        var dias = d.Dias;
                                        <button type="button" class="chip-radio @(_dias == dias ? "activo" : "")" @onclick="() => _dias = dias">@d.Texto</button>
                                    }
                                </div>
                            </div>
                        </Tarjeta>
                    </Principal>
                    <Secundario>
                        <Tarjeta Titulo="Antes de enviar" Subtitulo="Revisa tu reporte.">
                            <div class="chequeo"><Icon Nombre="@(_tipo != null ? "IcoCheckCircle" : "IcoInfo")" Tam="18" Color="@(_tipo != null ? "var(--success)" : "var(--text-secondary)")" /> Problema elegido</div>
                            <div class="chequeo"><Icon Nombre="IcoCheckCircle" Tam="18" Color="var(--success)" /> Caduca solo: @TextoDuracion</div>
                            <Aviso Icono="IcoInfo" Titulo="Privacidad">No compartas datos personales de otras personas. El reporte lo verá toda la comunidad.</Aviso>
                            @if (_mensaje != null)
                            {
                                <p class="@(_exito ? "nota exito" : "error-texto")">@_mensaje</p>
                            }
                            <div class="arriba"><Boton Texto="@(_enviando ? "Enviando…" : "Enviar reporte")" Icono="IcoSend" OnClick="Enviar" /></div>
                        </Tarjeta>
                    </Secundario>
                </DosColumnas>
            </ChildContent>
        </MarcoDetalle>
        break;

    case "ayuda":
        <MarcoDetalle Categoria="Soporte" Titulo="Centro de ayuda" Subtitulo="Respuestas rápidas sobre cómo usar R.U.T.A.">
            <ChildContent>
                <Tarjeta Relleno="14">
                    <CampoTexto @bind-Text="_busqueda" Icono="IcoSearch" Hint="Buscar en el centro de ayuda..." Alto="44" />
                </Tarjeta>
                <div class="arriba-grande">
                    <Tarjeta Titulo="Preguntas frecuentes" Subtitulo="@(Visibles.Count() + " respuestas")">
                        @foreach (var p in Visibles)
                        {
                            var pregunta = p;
                            <div class="faq-bloque">
                                <div class="faq @(_abierta == pregunta.Pregunta ? "abierta" : "")" @onclick="() => Alternar(pregunta.Pregunta)" aria-expanded="@(_abierta == pregunta.Pregunta)">
                                    <span>@pregunta.Pregunta</span>
                                    <Icon Nombre="@(_abierta == pregunta.Pregunta ? "IcoChevronDown" : "IcoChevronRight")" Tam="15" />
                                </div>
                                @if (_abierta == pregunta.Pregunta)
                                {
                                    <p class="faq-resp anima-entra">@pregunta.Respuesta</p>
                                }
                            </div>
                        }
                        @if (!Visibles.Any())
                        {
                            <p class="vacio">No encontramos respuestas con ese texto.</p>
                        }
                    </Tarjeta>
                </div>
            </ChildContent>
        </MarcoDetalle>
        break;
}

@code {
    [Parameter] public string Clave { get; set; }

    // ── Reportar ──
    private record Duracion(string Texto, int Dias);
    private static readonly Duracion[] Duraciones = { new("1 día", 1), new("3 días", 3), new("7 días", 7) };

    private string _tipo;
    private string _detalle = "", _mensaje;
    private int _ruta, _dias = 1;
    private bool _enviando, _exito;

    private string TextoDuracion => Duraciones.First(d => d.Dias == _dias).Texto;

    private void ElegirTipo(EstadoApp.ProblemaComun t)
    {
        _tipo = t.Clave;
        _dias = t.Dias <= 1 ? 1 : t.Dias <= 3 ? 3 : 7;
    }

    private async Task Enviar()
    {
        if (_enviando) return;
        _exito = false;
        if (_tipo == null) { _mensaje = "Elige primero qué pasó."; return; }

        var tipo = EstadoApp.ProblemasComunes.First(t => t.Clave == _tipo);
        var ruta = _ruta > 0 ? Estado.BuscarRuta(_ruta) : null;
        string titulo = tipo.Texto + (ruta != null ? " en " + ruta.Nombre : "");

        _enviando = true;
        try
        {
            var (ok, error) = await Estado.PublicarAvisoAsync(titulo, string.IsNullOrWhiteSpace(_detalle) ? "Reportado desde Configuración." : _detalle.Trim(), ruta, _dias);
            _exito = ok;
            _mensaje = ok ? "¡Gracias! Tu reporte ya es visible para la comunidad." : error;
            if (ok) { _tipo = null; _detalle = ""; _ruta = 0; }
        }
        finally
        {
            _enviando = false;
        }
    }

    // ── Centro de ayuda ──
    private record PreguntaAyuda(string Pregunta, string Respuesta);

    private static readonly PreguntaAyuda[] Preguntas =
    {
        new("¿Cómo planifico un viaje?", "En Planificar viaje escribe de dónde sales y a dónde vas (o toca el mapa con «Elegir en el mapa») y pulsa «Buscar y comparar rutas». Elige una opción y pulsa «Comenzar viaje» para ver los pasos."),
        new("¿Cómo guardo una ruta?", "En Rutas toca el marcador de la ruta. Guardar rutas, viajes y lugares requiere iniciar sesión; las rutas guardadas salen en tu perfil."),
        new("¿Cómo guardo mi casa o mi escuela?", "En Planificar viaje, en «Mis lugares», pulsa «Guardar un lugar»: ponle nombre y elige dónde está con «Mi ubicación», tocando el mapa o escribiendo la dirección. Después aparece como atajo para llenar origen o destino."),
        new("¿Cómo comparto un viaje?", "En Comparar rutas pulsa el icono de compartir de la opción que quieras y copia el código. Quien lo reciba lo pega en Planificar viaje → «Pegar un código» y lo ve en el mapa."),
        new("¿Cómo reporto un problema en la ruta?", "En el mapa pulsa el megáfono, elige el problema (ponchadura, se quedó tirado, tráfico…) y envía. También puedes hacerlo desde Configuración → Reportar un problema. El aviso caduca solo."),
        new("¿Por qué desaparecen algunas publicaciones?", "Las publicaciones tienen fecha de caducidad: los avisos de problemas duran pocos días para que la comunidad vea solo información vigente."),
        new("¿Cómo cambio a millas?", "En Configuración → Unidades de distancia elige millas o kilómetros; se aplica al momento."),
        new("¿Qué hago si no distingo bien los colores?", "En Configuración → Accesibilidad activa el modo daltonismo: los colores pasan a tonos neutros y cada ruta se reconoce por su símbolo y su tipo de línea."),
        new("¿Puedo usar la app con el teclado?", "Sí. Activa la Guía visual en Configuración → Accesibilidad: verás siempre dónde estás, podrás moverte con Tab, elegir con Enter y cambiar de sección con Alt + 1 a 5. También aparecen botones «?» que explican cada parte."),
        new("¿Cómo borro mi historial de viajes?", "En Mi perfil → Historial pulsa «Borrar historial»."),
        new("¿Cómo cierro sesión o borro mi cuenta?", "En Configuración → Mi cuenta. Cerrar sesión pide confirmación; borrar la cuenta pide escribir BORRAR y elimina todos tus datos.")
    };

    private string _busqueda = "", _abierta;

    private IEnumerable<PreguntaAyuda> Visibles =>
        string.IsNullOrWhiteSpace(_busqueda)
            ? Preguntas
            : Preguntas.Where(p => Formato.Coincide(p.Pregunta, _busqueda.Trim()) || Formato.Coincide(p.Respuesta, _busqueda.Trim()));

    private void Alternar(string pregunta) => _abierta = _abierta == pregunta ? null : pregunta;
}
