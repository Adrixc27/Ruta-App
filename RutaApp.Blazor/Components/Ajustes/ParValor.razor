<div class="par-valor @(Recuadro ? "recuadro" : "") @(Linea && !Recuadro ? "con-linea" : "")">
    <span>@Etiqueta</span>
    <b>@Valor</b>
</div>

@code {
    [Parameter] public string Etiqueta { get; set; }
    [Parameter] public string Valor { get; set; }
    [Parameter] public bool Linea { get; set; } = true;
    [Parameter] public bool Recuadro { get; set; }
}
