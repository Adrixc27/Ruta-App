<input type="range" class="deslizador" min="0" max="100" value="@Valor" @oninput="AlCambiar" style="--p:@(Valor)%" />

@code {
    [Parameter] public int Valor { get; set; } = 50;
    [Parameter] public EventCallback<int> ValorChanged { get; set; }

    private async Task AlCambiar(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out int valor)) return;
        Valor = valor;
        await ValorChanged.InvokeAsync(valor);
    }
}
