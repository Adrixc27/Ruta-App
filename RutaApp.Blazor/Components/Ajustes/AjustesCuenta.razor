@inject EstadoApp Estado

@* Ajustes → Mi cuenta: sesión, "recordarme", cerrar sesión (con confirmación) y borrar la cuenta. *@
@switch (Clave)
{
    case "cuenta":
        <MarcoDetalle Categoria="Cuenta" Titulo="Mi cuenta" Subtitulo="Tu sesión y tus datos en R.U.T.A.">
            <ChildContent>
                @if (!Estado.ConCuenta)
                {
                    <Tarjeta Titulo="No has iniciado sesión" Subtitulo="Estás explorando sin cuenta.">
                        <p class="nota">Con una cuenta puedes guardar rutas, lugares y viajes, ver tu historial y participar en la comunidad.</p>
                        <div class="arriba"><Boton Texto="Iniciar sesión" Icono="IcoUser" OnClick="Estado.IrAIniciarSesion" /></div>
                    </Tarjeta>
                }
                else
                {
                    <DosColumnas Lateral="396">
                        <Principal>
                            <Tarjeta Titulo="Sesión" Subtitulo="@(Estado.Nombre + " · " + Estado.Correo)">
                                <FilaAjuste Icono="IcoLock" Titulo="Mantener la sesión abierta"
                                            Descripcion="Al abrir la app seguirás dentro de tu cuenta sin volver a iniciar sesión (solo en este equipo).">
                                    <Interruptor Activo="Recordada" ActivoChanged="Recordar" />
                                </FilaAjuste>
                                <div class="arriba"><Boton Texto="Cerrar sesión" Icono="IcoLogout" Relleno="false" OnClick="Estado.PedirCierreSesion" /></div>
                            </Tarjeta>
                        </Principal>
                        <Secundario>
                            <Tarjeta Titulo="Borrar mi cuenta" Subtitulo="Esta acción no se puede deshacer." Clase="tarjeta-peligro">
                                <p class="nota">Se borran tu cuenta, tus publicaciones y comentarios, tus rutas guardadas, tu historial, tus viajes y tus lugares guardados.</p>
                                <div class="etiquetado arriba">
                                    <label>Para confirmar, escribe BORRAR</label>
                                    <CampoTexto @bind-Text="_confirmacion" Hint="BORRAR" Alto="42" />
                                </div>
                                @if (_error != null) { <p class="error-texto">@_error</p> }
                                <div class="arriba">
                                    <button type="button" class="btn btn-peligro btn-ancho" disabled="@(!PuedeBorrar)" @onclick="Borrar">
                                        <Icon Nombre="IcoTrash" Tam="17" /> @(_borrando ? "Borrando…" : "Borrar mi cuenta")
                                    </button>
                                </div>
                            </Tarjeta>
                        </Secundario>
                    </DosColumnas>
                }
            </ChildContent>
        </MarcoDetalle>
        break;
}

@code {
    [Parameter] public string Clave { get; set; }

    private string _confirmacion = "", _error;
    private bool _borrando;

    private bool Recordada => Estado.Ajustes.Datos.SesionUsuarioId == Estado.Usuario?.Id;
    private bool PuedeBorrar => !_borrando && _confirmacion.Trim().Equals("BORRAR", StringComparison.OrdinalIgnoreCase);

    private void Recordar(bool valor)
    {
        Estado.RecordarSesion(valor);
        Estado.MostrarAviso(valor ? "La sesión se mantendrá abierta" : "Ya no se recordará la sesión");
    }

    private async Task Borrar()
    {
        if (!PuedeBorrar) return;
        _borrando = true;
        _error = null;
        try
        {
            _error = await Estado.BorrarCuentaAsync();   // si sale bien, la app vuelve a la landing
        }
        finally
        {
            _borrando = false;
        }
    }
}
