@* Caja de contraseña con botón para mostrarla u ocultarla. *@
<CampoTexto Text="@Text" TextChanged="@TextChanged" Icono="IcoLock" Hint="••••••••" Tipo="@(_visible ? "text" : "password")">
    <button type="button" class="btn-icono" title="Mostrar u ocultar contraseña" @onclick="() => _visible = !_visible">
        <Icon Nombre="IcoEye" Tam="18" />
    </button>
</CampoTexto>

@code {
    [Parameter] public string Text { get; set; } = "";
    [Parameter] public EventCallback<string> TextChanged { get; set; }

    private bool _visible;
}
