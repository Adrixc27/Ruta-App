@inject IJSRuntime JS

@* Compartir en 3 pasos: copiar el código, enviarlo, y que la otra persona lo pegue en Planificar. *@
@if (Visible)
{
    <div class="modal-fondo" @onclick="Cerrar">
        <div class="modal modal-compartir" @onclick:stopPropagation="true">
            <div class="modal-cabecera">
                <div>
                    <h2>Compartir</h2>
                    <p>@Titulo</p>
                </div>
                <button type="button" class="btn-icono suave" title="Cerrar" @onclick="Cerrar"><Icon Nombre="IcoX" Tam="16" /></button>
            </div>

            <ol class="compartir-pasos">
                <li><span>1</span> Copia el código</li>
                <li><span>2</span> Envíalo por mensaje</li>
                <li><span>3</span> La otra persona lo pega en <b>Planificar → Pegar un código</b></li>
            </ol>

            <button type="button" class="btn btn-grande btn-ancho @(_copiado ? "btn-exito" : "btn-primario")" @onclick="Copiar">
                <Icon Nombre="@(_copiado ? "IcoCheck" : "IcoCopy")" Tam="18" /> @(_copiado ? "¡Código copiado!" : "Copiar código")
            </button>

            <input id="@_idCodigo" class="codigo-linea" readonly value="@Codigo" @onfocus="Seleccionar" aria-label="Código para compartir" />
            @if (_mensaje != null)
            {
                <p class="aviso-texto">@_mensaje</p>
            }
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public string Titulo { get; set; } = "";
    [Parameter] public string Codigo { get; set; } = "";

    private readonly string _idCodigo = "codigo-" + Guid.NewGuid().ToString("N");
    private string _mensaje;
    private bool _copiado;

    protected override void OnParametersSet()
    {
        if (!Visible) { _mensaje = null; _copiado = false; }
    }

    private async Task Cerrar()
    {
        Visible = false;
        await VisibleChanged.InvokeAsync(false);
    }

    private async Task Seleccionar()
    {
        try { await JS.InvokeVoidAsync("eval", "document.getElementById('" + _idCodigo + "')?.select()"); }
        catch (Exception) { }
    }

    private async Task Copiar()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", Codigo);
            _copiado = true;
            _mensaje = null;
        }
        catch (Exception)
        {
            await Seleccionar();
            _mensaje = "No se pudo copiar solo: el código ya está seleccionado, cópialo con Ctrl+C.";
        }
    }
}
