<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Ruta_App">

    <!-- ═══════════════ TOKENS DE COLOR (sacados de Figma) ═══════════════ -->
    <SolidColorBrush x:Key="BrandPrimary" Color="#2563EB"/>
    <SolidColorBrush x:Key="BrandTint" Color="#DBEAFE"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#1B365D"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#4A6FA5"/>
    <SolidColorBrush x:Key="BorderDefault" Color="#B0CDEA"/>
    <SolidColorBrush x:Key="BorderSoft" Color="#C8DCEF"/>
    <SolidColorBrush x:Key="BgSidebar" Color="#D0E3F5"/>
    <SolidColorBrush x:Key="BgPage" Color="#C4DBF0"/>
    <SolidColorBrush x:Key="BgPanel" Color="#E6F0FA"/>
    <SolidColorBrush x:Key="BgCard" Color="#F4F8FD"/>
    <SolidColorBrush x:Key="BgWhite" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Warning" Color="#B45309"/>
    <SolidColorBrush x:Key="WarningTint" Color="#FEF3C7"/>
    <SolidColorBrush x:Key="Success" Color="#16A34A"/>
    <SolidColorBrush x:Key="SuccessTint" Color="#DCFCE7"/>
    <SolidColorBrush x:Key="Danger" Color="#DC2626"/>
    <SolidColorBrush x:Key="AccentReference" Color="#5EEAD4"/>
    <SolidColorBrush x:Key="AccentOrigin" Color="#F9A8A8"/>
    <SolidColorBrush x:Key="AccentStop" Color="#FACC15"/>
    <SolidColorBrush x:Key="StarYellow" Color="#FBBF24"/>
    <SolidColorBrush x:Key="Overlay" Color="#661B365D"/>

    <!-- Fuente: instala "Source Sans Pro" (o "Source Sans 3"); si no está usa Segoe UI -->
    <FontFamily x:Key="Fuente">Source Sans Pro, Segoe UI</FontFamily>

    <BooleanToVisibilityConverter x:Key="BoolVis"/>
    <local:IconoConverter x:Key="Ico"/>

